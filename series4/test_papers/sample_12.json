[
  {"id":1,"question":"If market interest rates rise, the price of an existing fixed-rate bond will:","options":["Rise","Fall","Remain unchanged","Become zero"],"answer":"Fall","hint":"Inverse relationship","explanation":"Bond prices move inversely to interest rates."},

