[
  {"id":7101,"question":"Foreign Exchange market is also known as:","options":["Equity market","Forex market","Commodity market","Bond market"],"answer":"Forex market","hint":"FX","explanation":"Foreign exchange market is commonly called Forex or FX market."},
  {"id":7102,"question":"Which body manages India's foreign reserves?","options":["SEBI","RBI","NSE","Finance Ministry"],"answer":"RBI","hint":"Central Bank","explanation":"RBI holds and manages foreign exchange reserves of India."},
  {"id":7103,"question":"In India, USD/INR quotation is:","options":["Indirect","Direct","Cross","None"],"answer":"Direct","hint":"INR per USD","explanation":"India follows direct quotation method."},
  {"id":7104,"question":"When INR strengthens, it is called:","options":["Depreciation","Appreciation","Inflation","Devaluation"],"answer":"Appreciation","hint":"Higher value","explanation":"Appreciation means increase in currency value."},
  {"id":7105,"question":"Forex market is:","options":["Centralized","Decentralized","Closed","Local"],"answer":"Decentralized","hint":"No single exchange","explanation":"Forex trades globally without central exchange."},
  {"id":7106,"question":"Which is a major reserve currency?","options":["INR","USD","BDT","NPR"],"answer":"USD","hint":"Global use","explanation":"US Dollar is the primary reserve currency."},
  {"id":7107,"question":"Weak rupee benefits:","options":["Importers","Exporters","Bankers","SEBI"],"answer":"Exporters","hint":"More earnings","explanation":"Exporters receive more INR when rupee weakens."},
  {"id":7108,"question":"Strong rupee benefits:","options":["Exporters","Importers","Traders","SEBI"],"answer":"Importers","hint":"Pay less","explanation":"Importers pay fewer rupees for foreign goods."},
  {"id":7109,"question":"Forex market operates:","options":["Only weekdays","Only weekends","24 hours","Only mornings"],"answer":"24 hours","hint":"Global trading","explanation":"Different time zones keep market active."},
  {"id":7110,"question":"Which is NOT a forex participant?","options":["Bank","MNC","Tourist","Local vegetable seller"],"answer":"Local vegetable seller","hint":"Domestic trade","explanation":"Local sellers do not directly trade in forex."},

  {"id":7201,"question":"Forward contracts are mainly used for:","options":["Speculation","Hedging","Saving","Insurance"],"answer":"Hedging","hint":"Risk management","explanation":"Forwards reduce currency risk."},
  {"id":7202,"question":"Forwards are traded in:","options":["Stock exchange","OTC market","Crypto market","Commodity exchange"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are privately negotiated."},
  {"id":7203,"question":"Forward contract is settled:","options":["Today","In future","Immediately","Weekly"],"answer":"In future","hint":"Pre-agreed date","explanation":"Settlement happens on future date."},
  {"id":7204,"question":"Who mostly uses forward contracts?","options":["Exporters","Students","Doctors","Teachers"],"answer":"Exporters","hint":"Trade protection","explanation":"Exporters hedge currency risk."},
  {"id":7205,"question":"Forwards are:","options":["Standardized","Customized","Free","Government issued"],"answer":"Customized","hint":"Flexible terms","explanation":"Terms are negotiated between parties."},

  {"id":7301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Indian exchanges","explanation":"All major exchanges trade currency futures."},
  {"id":7302,"question":"Futures contracts are:","options":["Customized","Standardized","Flexible","Free"],"answer":"Standardized","hint":"Exchange rules","explanation":"Contract terms are fixed by exchange."},
  {"id":7303,"question":"Who guarantees settlement in futures?","options":["Trader","Clearing house","Bank","RBI"],"answer":"Clearing house","hint":"Risk manager","explanation":"Clearing house reduces counterparty risk."},
  {"id":7304,"question":"Daily profit/loss adjustment is called:","options":["Expiry","Mark-to-market","Delivery","Forward"],"answer":"Mark-to-market","hint":"MTM","explanation":"Daily settlement of gains/losses."},
  {"id":7305,"question":"Margin acts as:","options":["Fee","Security deposit","Tax","Penalty"],"answer":"Security deposit","hint":"Risk cover","explanation":"Margin protects against default."},
  {"id":7306,"question":"Lot size is decided by:","options":["Trader","Exchange","RBI","Bank"],"answer":"Exchange","hint":"Fixed quantity","explanation":"Exchange sets contract size."},
  {"id":7307,"question":"If USD/INR rises, exporter:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"More rupees","explanation":"Exporter benefits from higher USD value."},
  {"id":7308,"question":"If USD/INR falls, importer:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"Pays less","explanation":"Importer benefits from lower USD value."},
  {"id":7309,"question":"Most futures expire:","options":["Weekly","Monthly","Yearly","Daily"],"answer":"Monthly","hint":"Last Thursday","explanation":"Common expiry cycle."},
  {"id":7310,"question":"Tick size means:","options":["Lot size","Smallest price movement","Margin","Expiry"],"answer":"Smallest price movement","hint":"Minimum change","explanation":"Minimum allowed price change."},
  {"id":7311,"question":"Long position means:","options":["Buy","Sell","Hold","Save"],"answer":"Buy","hint":"Expect rise","explanation":"Buying a contract."},
  {"id":7312,"question":"Short position means:","options":["Buy","Sell","Deposit","Withdraw"],"answer":"Sell","hint":"Expect fall","explanation":"Selling a contract."},
  {"id":7313,"question":"If price rises, long position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Bought earlier","explanation":"Buyer benefits from price rise."},
  {"id":7314,"question":"If price falls, short position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Sold earlier","explanation":"Seller benefits from price fall."},
  {"id":7315,"question":"Most currency futures are:","options":["Physically settled","Cash settled","Gold settled","Barter"],"answer":"Cash settled","hint":"No delivery","explanation":"Settlement in cash."},
  {"id":7316,"question":"Final settlement price is declared by:","options":["Trader","Exchange","Bank","RBI"],"answer":"Exchange","hint":"Official rate","explanation":"Exchange publishes final price."},
  {"id":7317,"question":"Futures are mainly used for:","options":["Cooking","Hedging","Travel","Shopping"],"answer":"Hedging","hint":"Risk control","explanation":"Used to manage currency risk."},
  {"id":7318,"question":"Most traded pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular pair","explanation":"Most liquid currency pair in India."},
  {"id":7319,"question":"Initial margin is paid:","options":["At start","At expiry","After loss","Never"],"answer":"At start","hint":"Before trading","explanation":"Required before taking position."},
  {"id":7320,"question":"Maintenance margin is:","options":["Higher","Lower","Same","Zero"],"answer":"Lower","hint":"Minimum level","explanation":"Lower than initial margin."},

  {"id":7401,"question":"Option buyer has:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":7402,"question":"Call option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":7403,"question":"Put option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":7404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is option price."},
  {"id":7405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":7406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed price","explanation":"Pre-determined price."},
  {"id":7407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":7408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":7409,"question":"European option can be exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":7410,"question":"American option can be exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible type."},
  {"id":7411,"question":"Call buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Rises","hint":"Right to buy","explanation":"Higher price benefits call buyer."},
  {"id":7412,"question":"Put buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Falls","hint":"Right to sell","explanation":"Lower price benefits put buyer."},
  {"id":7413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer risks only premium."},
  {"id":7414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":7415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":7416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":7417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":7418,"question":"Currency options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Exchange-traded contracts."},
  {"id":7419,"question":"After paying premium, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":7420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
  { "id": 7501, "question": "Primary purpose of hedging is to:", "options": ["Reduce risk", "Maximize profit", "Avoid tax", "Speculate"], "answer": "Reduce risk", "hint": "Risk management.", "explanation": "Hedging protects against adverse currency movements." },
  { "id": 7502, "question": "If INR depreciates, who benefits?", "options": ["Exporter", "Importer", "Broker", "SEBI"], "answer": "Exporter", "hint": "Receives dollars.", "explanation": "Exporters receive more rupees for the same dollars." },
  { "id": 7503, "question": "Importer expecting rupee fall should:", "options": ["Buy USD futures", "Sell USD futures", "Buy shares", "Do nothing"], "answer": "Buy USD futures", "hint": "Lock future cost.", "explanation": "Buying futures helps fix future dollar rate." },
  { "id": 7504, "question": "Speculators mainly aim to:", "options": ["Earn profit", "Reduce risk", "Only hedge", "Avoid trading"], "answer": "Earn profit", "hint": "Profit motive.", "explanation": "Speculators take risk expecting gains." },
  { "id": 7505, "question": "Arbitrage opportunities arise due to:", "options": ["Price differences", "High risk", "Fixed return", "No trading"], "answer": "Price differences", "hint": "Market mismatch.", "explanation": "Arbitrageurs exploit price mismatches." },
  { "id": 7506, "question": "Which is a direct currency pair?", "options": ["USD/INR", "GBP/USD", "EUR/JPY", "AUD/GBP"], "answer": "USD/INR", "hint": "Involves INR.", "explanation": "Direct pair includes domestic currency." },
  { "id": 7507, "question": "Long hedge means:", "options": ["Buy futures", "Sell futures", "Hold cash", "Avoid trade"], "answer": "Buy futures", "hint": "Lock cost.", "explanation": "Used when prices are expected to rise." },
  { "id": 7508, "question": "Short hedge means:", "options": ["Sell futures", "Buy futures", "Hold cash", "Cancel trade"], "answer": "Sell futures", "hint": "Lock revenue.", "explanation": "Used when prices are expected to fall." },
  { "id": 7509, "question": "Basis risk arises because:", "options": ["Spot and futures may not move equally", "Only spot moves", "Only futures moves", "No trading"], "answer": "Spot and futures may not move equally", "hint": "Imperfect hedge.", "explanation": "Mismatch in movements creates basis risk." },
  { "id": 7510, "question": "Currency futures are:", "options": ["Standardized contracts", "Custom contracts", "Bank products", "Illegal"], "answer": "Standardized contracts", "hint": "Exchange traded.", "explanation": "Terms are fixed by exchanges." },

  { "id": 7601, "question": "ETCD stands for:", "options": ["Exchange Traded Currency Derivatives", "Electronic Currency Trading", "Equity Currency Derivatives", "None"], "answer": "Exchange Traded Currency Derivatives", "hint": "Full form.", "explanation": "Currency derivatives traded on exchanges." },
  { "id": 7602, "question": "ETCD trading is:", "options": ["Screen based", "Floor based", "Bank based", "Manual"], "answer": "Screen based", "hint": "Electronic.", "explanation": "Trades are executed electronically." },
  { "id": 7603, "question": "Who decides lot size?", "options": ["Exchange", "Trader", "Broker", "Bank"], "answer": "Exchange", "hint": "Contract terms.", "explanation": "Exchanges fix contract size." },
  { "id": 7604, "question": "Market order gives priority to:", "options": ["Speed", "Price", "Both", "None"], "answer": "Speed", "hint": "Immediate execution.", "explanation": "Executes at best available price." },
  { "id": 7605, "question": "Limit order gives priority to:", "options": ["Price", "Speed", "Broker", "Bank"], "answer": "Price", "hint": "Fixed rate.", "explanation": "Executes only at specified price." },
  { "id": 7606, "question": "IOC means:", "options": ["Immediate or Cancel", "Input or Cancel", "Immediate Only Contract", "None"], "answer": "Immediate or Cancel", "hint": "Order type.", "explanation": "Order executes immediately or gets canceled." },
  { "id": 7607, "question": "Open interest increases when:", "options": ["New positions created", "Positions closed", "No trading", "Only settlement"], "answer": "New positions created", "hint": "Fresh contracts.", "explanation": "OI rises with new contracts." },
  { "id": 7608, "question": "Open interest decreases when:", "options": ["Positions squared off", "New trades", "More buying", "More selling"], "answer": "Positions squared off", "hint": "Closing positions.", "explanation": "OI falls when contracts close." },
  { "id": 7609, "question": "Closing price is:", "options": ["Last traded price", "Highest price", "Lowest price", "Average price"], "answer": "Last traded price", "hint": "End of session.", "explanation": "Final price of trading day." },
  { "id": 7610, "question": "Daily price limits are set by:", "options": ["Exchange", "Trader", "Bank", "Broker"], "answer": "Exchange", "hint": "Circuit filter.", "explanation": "Exchanges control extreme movements." },

  { "id": 7701, "question": "Clearing house acts as:", "options": ["Central counterparty", "Trader", "Broker", "Bank"], "answer": "Central counterparty", "hint": "Guarantee.", "explanation": "Stands between buyer and seller." },
  { "id": 7702, "question": "Initial margin is paid by:", "options": ["Both buyer and seller", "Only buyer", "Only seller", "Only broker"], "answer": "Both buyer and seller", "hint": "Risk cover.", "explanation": "Margins collected from both sides." },
  { "id": 7703, "question": "Mark-to-market is done:", "options": ["Daily", "Weekly", "Monthly", "Yearly"], "answer": "Daily", "hint": "Daily adjustment.", "explanation": "Profits/losses settled daily." },
  { "id": 7704, "question": "Variation margin covers:", "options": ["Daily losses", "Initial deposit", "Only profit", "Broker fees"], "answer": "Daily losses", "hint": "MTM adjustment.", "explanation": "Loss traders pay variation margin." },
  { "id": 7705, "question": "Exposure margin depends on:", "options": ["Volatility", "Trader choice", "Fixed rate", "Broker decision"], "answer": "Volatility", "hint": "Risk based.", "explanation": "Higher volatility means higher margin." },
  { "id": 7706, "question": "If margin is not paid, position is:", "options": ["Squared off", "Carried forward", "Ignored", "Transferred"], "answer": "Squared off", "hint": "Default action.", "explanation": "Broker closes position." },
  { "id": 7707, "question": "Final settlement price is based on:", "options": ["RBI reference rate", "Broker rate", "Bank rate", "Trader rate"], "answer": "RBI reference rate", "hint": "Official rate.", "explanation": "RBI rate used for settlement." },
  { "id": 7708, "question": "Settlement type in ETCD is:", "options": ["Cash settlement", "Physical delivery", "Share delivery", "Gold delivery"], "answer": "Cash settlement", "hint": "No actual currency.", "explanation": "Most contracts are cash settled." },
  { "id": 7709, "question": "Default risk is managed by:", "options": ["Clearing corporation", "Trader", "Broker", "Bank"], "answer": "Clearing corporation", "hint": "Risk control.", "explanation": "Clearing house ensures settlement." },
  { "id": 7710, "question": "Margin money is kept with:", "options": ["Clearing corporation", "Broker", "Trader", "Bank"], "answer": "Clearing corporation", "hint": "Safe custody.", "explanation": "Margins are held centrally." },

  { "id": 7801, "question": "Primary regulator of ETCD is:", "options": ["SEBI", "RBI", "IRDA", "PFRDA"], "answer": "SEBI", "hint": "Securities regulator.", "explanation": "SEBI regulates derivatives markets." },
  { "id": 7802, "question": "Currency derivatives fall under:", "options": ["SCRA", "Income Tax Act", "Companies Act", "Banking Act"], "answer": "SCRA", "hint": "Legal framework.", "explanation": "Securities Contracts Act applies." },
  { "id": 7803, "question": "RBI regulates:", "options": ["Forex policy", "Stock trading", "Broker fees", "Tax rules"], "answer": "Forex policy", "hint": "Currency authority.", "explanation": "RBI oversees foreign exchange." },
  { "id": 7804, "question": "Only ______ can execute trades on exchange.", "options": ["Registered brokers", "Anyone", "Only banks", "Only FIIs"], "answer": "Registered brokers", "hint": "Authorized.", "explanation": "Retail trades via brokers." },
  { "id": 7805, "question": "SEBI’s main objective is:", "options": ["Investor protection", "Profit guarantee", "Lower tax", "Bank lending"], "answer": "Investor protection", "hint": "Market safety.", "explanation": "SEBI ensures fair markets." },

  { "id": 7901, "question": "Profit from ETCD is taxed as:", "options": ["Business income", "Salary", "Capital gain", "Dividend"], "answer": "Business income", "hint": "Trading nature.", "explanation": "Derivatives trading treated as business income." },
  { "id": 7902, "question": "MTM loss is:", "options": ["Allowed deduction", "Not allowed", "Capital loss", "Ignored"], "answer": "Allowed deduction", "hint": "Accounting rule.", "explanation": "MTM losses are recognized." },
  { "id": 7903, "question": "Turnover in derivatives is based on:", "options": ["Total contract value", "Only profit", "Only loss", "Only margin"], "answer": "Total contract value", "hint": "Tax basis.", "explanation": "Turnover includes full contract value." },
  { "id": 7904, "question": "Settlement gain is recognized:", "options": ["On settlement date", "Before trade", "Never", "After year end"], "answer": "On settlement date", "hint": "Realization.", "explanation": "Gains booked when settled." },
  { "id": 7905, "question": "ETCD trades must be recorded in:", "options": ["Books of accounts", "Only bank", "Only broker", "Memory"], "answer": "Books of accounts", "hint": "Accounting record.", "explanation": "Proper records mandatory." },

  { "id": 8001, "question": "Investor protection is ensured by:", "options": ["SEBI", "Broker", "Trader", "Bank"], "answer": "SEBI", "hint": "Regulator.", "explanation": "SEBI frames protection measures." },
  { "id": 8002, "question": "Brokers must follow:", "options": ["Code of conduct", "Client wishes", "No rules", "Only profit motive"], "answer": "Code of conduct", "hint": "Ethics.", "explanation": "Brokers must act ethically." },
  { "id": 8003, "question": "Misrepresentation to clients is:", "options": ["Prohibited", "Allowed", "Optional", "Encouraged"], "answer": "Prohibited", "hint": "Fair practice.", "explanation": "Brokers must give correct information." },
  { "id": 8004, "question": "Risk disclosure is:", "options": ["Mandatory", "Optional", "Not required", "Broker choice"], "answer": "Mandatory", "hint": "Investor awareness.", "explanation": "Clients must be informed of risks." },
  { "id": 8005, "question": "Grievance redressal protects:", "options": ["Investors", "Brokers only", "Exchanges only", "Banks only"], "answer": "Investors", "hint": "Complaint handling.", "explanation": "Investors can file complaints." }
]
