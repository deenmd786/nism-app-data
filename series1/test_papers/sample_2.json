[
  {"id":1101,"question":"Which market deals with foreign currencies?","options":["Money Market","Forex Market","Capital Market","Bond Market"],"answer":"Forex Market","hint":"FX","explanation":"Foreign Exchange market deals with currency trading."},
  {"id":1102,"question":"Who is the main regulator of forex in India?","options":["SEBI","RBI","NSE","IRDA"],"answer":"RBI","hint":"Central Bank","explanation":"RBI regulates foreign exchange in India."},
  {"id":1103,"question":"Which is not a major currency?","options":["USD","EUR","INR","JPY"],"answer":"INR","hint":"Global trading","explanation":"INR is not a major global reserve currency."},
  {"id":1104,"question":"Spot forex means settlement:","options":["After 2 days","After a month","Immediately","After a year"],"answer":"After 2 days","hint":"T+2","explanation":"Spot forex is normally settled on T+2 basis."},
  {"id":1105,"question":"Exchange rate is affected by:","options":["Demand and supply","Weather","Sports","Cinema"],"answer":"Demand and supply","hint":"Market force","explanation":"Currency value depends on demand and supply."},
  {"id":1106,"question":"Appreciation of INR means:","options":["INR becomes weaker","INR becomes stronger","No change","Becomes zero"],"answer":"INR becomes stronger","hint":"Higher value","explanation":"Appreciation means increase in currency value."},
  {"id":1107,"question":"Depreciation of INR benefits:","options":["Importers","Exporters","Banks","SEBI"],"answer":"Exporters","hint":"More rupees received","explanation":"Exporters gain when INR weakens."},
  {"id":1108,"question":"Forex market is mainly used for:","options":["Speculation","Risk management","Shopping","Travel only"],"answer":"Risk management","hint":"Hedging","explanation":"Businesses use forex to manage currency risk."},
  {"id":1109,"question":"Which is not a forex participant?","options":["Bank","Exporter","Farmer","Trader"],"answer":"Farmer","hint":"Financial market","explanation":"Farmers are not direct forex participants."},
  {"id":1110,"question":"Forex trading happens:","options":["Only in India","Only in USA","Globally","Only in banks"],"answer":"Globally","hint":"24-hour market","explanation":"Forex is a global decentralized market."},

  {"id":1201,"question":"Forward contract is traded in:","options":["Exchange","OTC market","Stock market","Commodity market"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are over-the-counter contracts."},
  {"id":1202,"question":"Main purpose of derivatives is:","options":["Gambling","Hedging","Saving","Deposits"],"answer":"Hedging","hint":"Risk protection","explanation":"Derivatives help manage price risk."},
  {"id":1203,"question":"Who uses forex forwards most?","options":["Exporters","Students","Doctors","Engineers"],"answer":"Exporters","hint":"Trade related","explanation":"Exporters hedge future receipts using forwards."},
  {"id":1204,"question":"Forward contract settlement is:","options":["Daily","Monthly","Future date","Never"],"answer":"Future date","hint":"Pre-agreed","explanation":"Settlement happens on a pre-decided future date."},
  {"id":1205,"question":"Forwards are usually:","options":["Standardized","Customized","Free","Optional"],"answer":"Customized","hint":"Flexible","explanation":"Forwards are tailored to parties’ needs."},

  {"id":1301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Exchanges","explanation":"All major Indian exchanges trade currency futures."},
  {"id":1302,"question":"Futures contracts are:","options":["Standardized","Customized","Free","Random"],"answer":"Standardized","hint":"Exchange traded","explanation":"Futures have fixed contract specifications."},
  {"id":1303,"question":"Who guarantees futures settlement?","options":["Trader","Clearing house","Bank","SEBI"],"answer":"Clearing house","hint":"Risk manager","explanation":"Clearing house reduces counterparty risk."},
  {"id":1304,"question":"Daily settlement in futures is called:","options":["Expiry","Mark-to-market","Delivery","Forward"],"answer":"Mark-to-market","hint":"MTM","explanation":"Profits/losses are settled daily."},
  {"id":1305,"question":"Margin is paid to:","options":["Broker","Exchange","Clearing house","Bank"],"answer":"Clearing house","hint":"Security deposit","explanation":"Margin protects against default risk."},
  {"id":1306,"question":"Lot size is decided by:","options":["Investor","Exchange","Bank","RBI"],"answer":"Exchange","hint":"Fixed size","explanation":"Exchanges define contract lot size."},
  {"id":1307,"question":"If INR falls, exporter:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"More rupees","explanation":"Weak rupee benefits exporters."},
  {"id":1308,"question":"If INR rises, importer:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"Pays less","explanation":"Strong rupee benefits importers."},
  {"id":1309,"question":"Expiry of most currency futures is:","options":["Weekly","Monthly","Yearly","Daily"],"answer":"Monthly","hint":"Last Thursday","explanation":"Contracts usually expire monthly."},
  {"id":1310,"question":"Tick size means:","options":["Lot size","Smallest price change","Margin","Expiry"],"answer":"Smallest price change","hint":"Minimum movement","explanation":"Minimum allowed price movement."},
  {"id":1311,"question":"Long position means:","options":["Buy","Sell","Deposit","Withdraw"],"answer":"Buy","hint":"Expect rise","explanation":"Long means buying a contract."},
  {"id":1312,"question":"Short position means:","options":["Buy","Sell","Hold","Save"],"answer":"Sell","hint":"Expect fall","explanation":"Short means selling a contract."},
  {"id":1313,"question":"If futures price rises, long gains?","options":["Yes","No","Maybe","Never"],"answer":"Yes","hint":"Bought earlier","explanation":"Long benefits from price rise."},
  {"id":1314,"question":"If futures price falls, short gains?","options":["Yes","No","Maybe","Never"],"answer":"Yes","hint":"Sold earlier","explanation":"Short benefits from price fall."},
  {"id":1315,"question":"Currency futures are mostly:","options":["Physically settled","Cash settled","Gold settled","Barter"],"answer":"Cash settled","hint":"No delivery","explanation":"Most contracts are cash settled."},
  {"id":1316,"question":"Final settlement price is set by:","options":["Trader","Exchange","Bank","RBI"],"answer":"Exchange","hint":"Official","explanation":"Exchange declares final price."},
  {"id":1317,"question":"Futures help in:","options":["Cooking","Hedging","Travel","Shopping"],"answer":"Hedging","hint":"Risk control","explanation":"Used to manage currency risk."},
  {"id":1318,"question":"Most common pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular pair","explanation":"USD/INR is widely traded."},
  {"id":1319,"question":"Initial margin is paid:","options":["After loss","At start","At expiry","Never"],"answer":"At start","hint":"Entry cost","explanation":"Margin is paid before trading."},
  {"id":1320,"question":"Maintenance margin is:","options":["Higher than initial","Lower than initial","Same","Zero"],"answer":"Lower than initial","hint":"Minimum level","explanation":"It is lower than initial margin."},

  {"id":1401,"question":"Option gives buyer a:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":1402,"question":"Call option is right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":1403,"question":"Put option is right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":1404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is option price."},
  {"id":1405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":1406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed","explanation":"Predetermined price."},
  {"id":1407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":1408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":1409,"question":"European option can be exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":1410,"question":"American option can be exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible option type."},
  {"id":1411,"question":"Who gains from call when price rises?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to buy","explanation":"Call buyer benefits."},
  {"id":1412,"question":"Who gains from put when price falls?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to sell","explanation":"Put buyer benefits."},
  {"id":1413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer loses only premium."},
  {"id":1414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":1415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":1416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":1417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":1418,"question":"Options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Currency options are exchange traded."},
  {"id":1419,"question":"If premium paid, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":1420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
