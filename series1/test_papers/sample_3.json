  {"id":2412,"question":"Who gains from put when price falls?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to sell","explanation":"Put buyer benefits."},
  {"id":2413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer loses only premium."},
  {"id":2414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":2415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":2416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":2417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
