  {"id":2110,"question":"Which market works 24 hours?","options":["Stock market","Forex market","Bond market","Commodity market"],"answer":"Forex market","hint":"Global trading","explanation":"Forex operates across global time zones."},

  {"id":2201,"question":"Forward contract is an agreement for:","options":["Today","Future","Past","Never"],"answer":"Future","hint":"Pre-agreed","explanation":"Forwards are settled at a future date."},
