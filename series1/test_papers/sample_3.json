  {"id":2101,"question":"Foreign exchange refers to:","options":["Domestic money","Foreign currency transactions","Bank deposits","Gold trading"],"answer":"Foreign currency transactions","hint":"Currency exchange","explanation":"Forex involves buying and selling of foreign currencies."},
  {"id":2102,"question":"Which institution manages India's foreign reserves?","options":["SEBI","RBI","NSE","Ministry of Finance"],"answer":"RBI","hint":"Central bank","explanation":"RBI manages and maintains foreign reserves of India."},
  {"id":2103,"question":"Which is a convertible currency?","options":["INR","USD","Rupee","None"],"answer":"USD","hint":"Freely exchangeable","explanation":"USD is freely convertible in international markets."},
