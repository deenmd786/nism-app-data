[
  {"id":3101,"question":"Foreign Exchange means:","options":["Domestic trade","Trading of foreign currencies","Gold trading","Bank deposits"],"answer":"Trading of foreign currencies","hint":"Currency exchange","explanation":"Forex involves buying and selling of foreign currencies."},
  {"id":3102,"question":"Which authority manages forex in India?","options":["SEBI","RBI","NSE","IRDA"],"answer":"RBI","hint":"Central bank","explanation":"RBI regulates foreign exchange transactions in India."},
  {"id":3103,"question":"Which is a major global currency?","options":["INR","USD","NGN","BDT"],"answer":"USD","hint":"Global reserve","explanation":"US Dollar is the most widely used global currency."},
  {"id":3104,"question":"Spot market settlement is generally:","options":["T+1","T+2","T+5","Immediate"],"answer":"T+2","hint":"Two days","explanation":"Forex spot transactions usually settle on T+2 basis."},
  {"id":3105,"question":"Exchange rate depends on:","options":["Weather","Demand and supply","RBI only","SEBI only"],"answer":"Demand and supply","hint":"Market forces","explanation":"Currency rates move based on demand and supply."},
  {"id":3106,"question":"If INR strengthens, it is called:","options":["Depreciation","Appreciation","Stagnation","Inflation"],"answer":"Appreciation","hint":"Higher value","explanation":"Appreciation means increase in currency value."},
  {"id":3107,"question":"Depreciation of INR benefits:","options":["Importers","Exporters","Banks","SEBI"],"answer":"Exporters","hint":"More rupees","explanation":"Exporters gain when rupee weakens."},
  {"id":3108,"question":"Forex is mainly used for:","options":["Gambling","International trade","Fixed deposits","Insurance"],"answer":"International trade","hint":"Business use","explanation":"Forex supports cross-border trade and payments."},
  {"id":3109,"question":"Which is NOT a direct forex participant?","options":["Bank","Exporter","Retail shopkeeper","Trader"],"answer":"Retail shopkeeper","hint":"Financial market","explanation":"Retail shopkeepers are not direct forex participants."},
  {"id":3110,"question":"Forex market works:","options":["Only daytime","Only night","24 hours","Only weekdays"],"answer":"24 hours","hint":"Global market","explanation":"Forex operates across different time zones."},

  {"id":3201,"question":"Forward contract is settled:","options":["Today","In future","Never","Weekly"],"answer":"In future","hint":"Advance agreement","explanation":"Forwards are settled on a future date."},
  {"id":3202,"question":"Forwards are traded in:","options":["Exchange","OTC market","Commodity market","Stock market"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are over-the-counter contracts."},
  {"id":3203,"question":"Who mainly uses forwards?","options":["Exporters","Students","Doctors","Engineers"],"answer":"Exporters","hint":"Trade risk","explanation":"Exporters hedge currency risk using forwards."},
  {"id":3204,"question":"Main purpose of derivatives is:","options":["Gambling","Hedging","Saving","Banking"],"answer":"Hedging","hint":"Risk control","explanation":"Derivatives help manage price risk."},
  {"id":3205,"question":"Forwards are usually:","options":["Standardized","Customized","Free","Daily"],"answer":"Customized","hint":"Flexible","explanation":"Terms are negotiated between parties."},

  {"id":3301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Indian exchanges","explanation":"All major exchanges trade currency futures."},
  {"id":3302,"question":"Futures contracts are:","options":["Customized","Standardized","Free","Optional"],"answer":"Standardized","hint":"Exchange rules","explanation":"Contract terms are fixed by exchange."},
  {"id":3303,"question":"Who guarantees settlement in futures?","options":["Trader","Clearing house","Bank","SEBI"],"answer":"Clearing house","hint":"Risk manager","explanation":"Clearing house reduces counterparty risk."},
  {"id":3304,"question":"Daily settlement is called:","options":["Expiry","Mark-to-market","Delivery","Forward"],"answer":"Mark-to-market","hint":"MTM","explanation":"Daily profit/loss adjustment."},
  {"id":3305,"question":"Margin acts as:","options":["Loan","Security deposit","Tax","Interest"],"answer":"Security deposit","hint":"Risk cover","explanation":"Margin protects against default."},
  {"id":3306,"question":"Lot size is decided by:","options":["Trader","Exchange","RBI","Bank"],"answer":"Exchange","hint":"Fixed quantity","explanation":"Exchange defines contract lot size."},
  {"id":3307,"question":"If INR falls, exporter:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"More rupees","explanation":"Weak rupee benefits exporters."},
  {"id":3308,"question":"If INR rises, importer:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"Pays less","explanation":"Strong rupee helps importers."},
  {"id":3309,"question":"Expiry of most contracts is:","options":["Weekly","Monthly","Yearly","Daily"],"answer":"Monthly","hint":"Last Thursday","explanation":"Most currency futures expire monthly."},
  {"id":3310,"question":"Tick size means:","options":["Lot size","Smallest price change","Margin","Expiry"],"answer":"Smallest price change","hint":"Minimum movement","explanation":"Minimum allowed price fluctuation."},
  {"id":3311,"question":"Long position means:","options":["Buy","Sell","Deposit","Withdraw"],"answer":"Buy","hint":"Expect rise","explanation":"Long position is buying."},
  {"id":3312,"question":"Short position means:","options":["Buy","Sell","Hold","Save"],"answer":"Sell","hint":"Expect fall","explanation":"Short position is selling."},
  {"id":3313,"question":"If price rises, long position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Bought earlier","explanation":"Long benefits from price rise."},
  {"id":3314,"question":"If price falls, short position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Sold earlier","explanation":"Short benefits from price fall."},
  {"id":3315,"question":"Futures are mostly:","options":["Physically settled","Cash settled","Gold settled","Barter"],"answer":"Cash settled","hint":"No delivery","explanation":"Most contracts are cash settled."},
  {"id":3316,"question":"Final settlement price is given by:","options":["Trader","Exchange","Bank","RBI"],"answer":"Exchange","hint":"Official rate","explanation":"Exchange declares final price."},
  {"id":3317,"question":"Futures are used for:","options":["Cooking","Hedging","Travel","Shopping"],"answer":"Hedging","hint":"Risk control","explanation":"Used to manage currency risk."},
  {"id":3318,"question":"Most common pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular","explanation":"Widely traded pair in India."},
  {"id":3319,"question":"Initial margin is paid:","options":["At start","At expiry","After loss","Never"],"answer":"At start","hint":"Before trading","explanation":"Paid before entering contract."},
  {"id":3320,"question":"Maintenance margin is:","options":["Higher","Lower","Same","Zero"],"answer":"Lower","hint":"Minimum level","explanation":"Lower than initial margin."},

  {"id":3401,"question":"Option gives buyer a:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":3402,"question":"Call option is right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":3403,"question":"Put option is right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":3404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is price of option."},
  {"id":3405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":3406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed price","explanation":"Predetermined price."},
  {"id":3407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":3408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":3409,"question":"European option is exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":3410,"question":"American option is exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible type."},
  {"id":3411,"question":"Who gains from call when price rises?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to buy","explanation":"Call buyer benefits."},
  {"id":3412,"question":"Who gains from put when price falls?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to sell","explanation":"Put buyer benefits."},
  {"id":3413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer loses only premium."},
  {"id":3414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":3415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":3416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":3417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":3418,"question":"Options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Currency options are exchange traded."},
  {"id":3419,"question":"If premium paid, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":3420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
  { "id": 3501, "question": "Main purpose of hedging is to:", "options": ["Reduce risk", "Earn maximum profit", "Avoid tax", "Speculate"], "answer": "Reduce risk", "hint": "Risk management.", "explanation": "Hedging is used to protect against adverse price movements." },
  { "id": 3502, "question": "If INR weakens, who benefits?", "options": ["Exporter", "Importer", "Broker", "SEBI"], "answer": "Exporter", "hint": "Receives dollars.", "explanation": "Exporters receive more rupees when INR depreciates." },
  { "id": 3503, "question": "Importer expecting rupee depreciation should:", "options": ["Buy USD futures", "Sell USD futures", "Buy shares", "Do nothing"], "answer": "Buy USD futures", "hint": "Lock future cost.", "explanation": "Buying futures helps fix future dollar rate." },
  { "id": 3504, "question": "Speculators mainly aim to:", "options": ["Earn profit", "Reduce risk", "Only hedge", "Avoid trading"], "answer": "Earn profit", "hint": "Profit motive.", "explanation": "Speculators take risk expecting gains." },
  { "id": 3505, "question": "Arbitrage opportunities arise due to:", "options": ["Price differences", "High risk", "Fixed return", "No trading"], "answer": "Price differences", "hint": "Market mismatch.", "explanation": "Arbitrageurs exploit price mismatches." },
  { "id": 3506, "question": "Which is a cross-currency pair?", "options": ["GBP/USD", "USD/INR", "INR/INR", "RBI/INR"], "answer": "GBP/USD", "hint": "No INR.", "explanation": "Cross pairs exclude INR." },
  { "id": 3507, "question": "Long hedge means:", "options": ["Buy futures", "Sell futures", "Hold cash", "Avoid trade"], "answer": "Buy futures", "hint": "Lock cost.", "explanation": "Used when prices expected to rise." },
  { "id": 3508, "question": "Short hedge means:", "options": ["Sell futures", "Buy futures", "Hold cash", "Cancel trade"], "answer": "Sell futures", "hint": "Lock revenue.", "explanation": "Used when prices expected to fall." },
  { "id": 3509, "question": "Basis risk arises due to:", "options": ["Spot and futures move differently", "Only spot moves", "Only futures move", "No trading"], "answer": "Spot and futures move differently", "hint": "Imperfect hedge.", "explanation": "Mismatch in movements creates basis risk." },
  { "id": 3510, "question": "Currency futures are:", "options": ["Standardized contracts", "Custom contracts", "Bank products", "Illegal"], "answer": "Standardized contracts", "hint": "Exchange traded.", "explanation": "Terms are fixed by exchanges." },

  { "id": 3601, "question": "ETCD stands for:", "options": ["Exchange Traded Currency Derivatives", "Equity Traded Currency Derivatives", "Electronic Currency Trading", "None"], "answer": "Exchange Traded Currency Derivatives", "hint": "Full form.", "explanation": "Currency derivatives traded on exchanges." },
  { "id": 3602, "question": "ETCD trading is:", "options": ["Screen based", "Floor based", "Bank based", "Manual"], "answer": "Screen based", "hint": "Electronic.", "explanation": "Trades are executed electronically." },
  { "id": 3603, "question": "Who decides lot size?", "options": ["Exchange", "Trader", "Broker", "Bank"], "answer": "Exchange", "hint": "Contract terms.", "explanation": "Exchanges fix contract size." },
  { "id": 3604, "question": "Market order gives priority to:", "options": ["Speed", "Price", "Both", "None"], "answer": "Speed", "hint": "Immediate execution.", "explanation": "Executes at best available price." },
  { "id": 3605, "question": "Limit order gives priority to:", "options": ["Price", "Speed", "Broker", "Bank"], "answer": "Price", "hint": "Fixed rate.", "explanation": "Executes only at specified price." },
  { "id": 3606, "question": "IOC means:", "options": ["Immediate or Cancel", "Input or Cancel", "Immediate Only Contract", "None"], "answer": "Immediate or Cancel", "hint": "Order type.", "explanation": "Order executes immediately or gets canceled." },
  { "id": 3607, "question": "Open interest increases when:", "options": ["New positions created", "Positions closed", "No trading", "Only settlement"], "answer": "New positions created", "hint": "Fresh contracts.", "explanation": "OI rises with new contracts." },
  { "id": 3608, "question": "Open interest decreases when:", "options": ["Positions squared off", "New trades", "More buying", "More selling"], "answer": "Positions squared off", "hint": "Closing positions.", "explanation": "OI falls when contracts close." },
  { "id": 3609, "question": "Closing price is:", "options": ["Last traded price", "Highest price", "Lowest price", "Average price"], "answer": "Last traded price", "hint": "End of session.", "explanation": "Final price of trading day." },
  { "id": 3610, "question": "Daily price limits are set by:", "options": ["Exchange", "Trader", "Bank", "Broker"], "answer": "Exchange", "hint": "Circuit filter.", "explanation": "Exchanges control extreme movements." },

  { "id": 3701, "question": "Clearing house acts as:", "options": ["Central counterparty", "Trader", "Broker", "Bank"], "answer": "Central counterparty", "hint": "Guarantee.", "explanation": "Stands between buyer and seller." },
  { "id": 3702, "question": "Initial margin is paid by:", "options": ["Both buyer and seller", "Only buyer", "Only seller", "Only broker"], "answer": "Both buyer and seller", "hint": "Risk cover.", "explanation": "Margins collected from both sides." },
  { "id": 3703, "question": "Mark-to-market is done:", "options": ["Daily", "Weekly", "Monthly", "Yearly"], "answer": "Daily", "hint": "Daily adjustment.", "explanation": "Profits/losses settled daily." },
  { "id": 3704, "question": "Variation margin covers:", "options": ["Daily losses", "Initial deposit", "Only profit", "Broker fees"], "answer": "Daily losses", "hint": "MTM adjustment.", "explanation": "Loss traders pay variation margin." },
  { "id": 3705, "question": "Exposure margin depends on:", "options": ["Volatility", "Trader choice", "Fixed rate", "Broker decision"], "answer": "Volatility", "hint": "Risk based.", "explanation": "Higher volatility means higher margin." },
  { "id": 3706, "question": "If margin is not paid, position is:", "options": ["Squared off", "Carried forward", "Ignored", "Transferred"], "answer": "Squared off", "hint": "Default action.", "explanation": "Broker closes position." },
  { "id": 3707, "question": "Final settlement price is based on:", "options": ["RBI reference rate", "Broker rate", "Bank rate", "Trader rate"], "answer": "RBI reference rate", "hint": "Official rate.", "explanation": "RBI rate used for settlement." },
  { "id": 3708, "question": "Settlement type in ETCD is:", "options": ["Cash settlement", "Physical delivery", "Share delivery", "Gold delivery"], "answer": "Cash settlement", "hint": "No actual currency.", "explanation": "Most contracts are cash settled." },
  { "id": 3709, "question": "Default risk is managed by:", "options": ["Clearing corporation", "Trader", "Broker", "Bank"], "answer": "Clearing corporation", "hint": "Risk control.", "explanation": "Clearing house ensures settlement." },
  { "id": 3710, "question": "Margin money is kept with:", "options": ["Clearing corporation", "Broker", "Trader", "Bank"], "answer": "Clearing corporation", "hint": "Safe custody.", "explanation": "Margins are held centrally." },

  { "id": 3801, "question": "Primary regulator of ETCD is:", "options": ["SEBI", "RBI", "IRDA", "PFRDA"], "answer": "SEBI", "hint": "Securities regulator.", "explanation": "SEBI regulates derivatives markets." },
  { "id": 3802, "question": "Currency derivatives fall under:", "options": ["SCRA", "Income Tax Act", "Companies Act", "Banking Act"], "answer": "SCRA", "hint": "Legal framework.", "explanation": "Securities Contracts Act applies." },
  { "id": 3803, "question": "RBI regulates:", "options": ["Forex policy", "Stock trading", "Broker fees", "Tax rules"], "answer": "Forex policy", "hint": "Currency authority.", "explanation": "RBI oversees foreign exchange." },
  { "id": 3804, "question": "Only ______ can execute trades on exchange.", "options": ["Registered brokers", "Anyone", "Only banks", "Only FIIs"], "answer": "Registered brokers", "hint": "Authorized.", "explanation": "Retail trades via brokers." },
  { "id": 3805, "question": "SEBI’s main objective is:", "options": ["Investor protection", "Profit guarantee", "Lower tax", "Bank lending"], "answer": "Investor protection", "hint": "Market safety.", "explanation": "SEBI ensures fair markets." },

  { "id": 3901, "question": "Profit from ETCD is taxed as:", "options": ["Business income", "Salary", "Capital gain", "Dividend"], "answer": "Business income", "hint": "Trading nature.", "explanation": "Derivatives trading treated as business income." },
  { "id": 3902, "question": "MTM loss is:", "options": ["Allowed deduction", "Not allowed", "Capital loss", "Ignored"], "answer": "Allowed deduction", "hint": "Accounting rule.", "explanation": "MTM losses are recognized." },
  { "id": 3903, "question": "Turnover in derivatives is based on:", "options": ["Total contract value", "Only profit", "Only loss", "Only margin"], "answer": "Total contract value", "hint": "Tax basis.", "explanation": "Turnover includes full contract value." },
  { "id": 3904, "question": "Settlement gain is recognized:", "options": ["On settlement date", "Before trade", "Never", "After year end"], "answer": "On settlement date", "hint": "Realization.", "explanation": "Gains booked when settled." },
  { "id": 3905, "question": "ETCD trades must be recorded in:", "options": ["Books of accounts", "Only bank", "Only broker", "Memory"], "answer": "Books of accounts", "hint": "Accounting record.", "explanation": "Proper records mandatory." },

  { "id": 4001, "question": "Investor protection is ensured by:", "options": ["SEBI", "Broker", "Trader", "Bank"], "answer": "SEBI", "hint": "Regulator.", "explanation": "SEBI frames protection measures." },
  { "id": 4002, "question": "Brokers must follow:", "options": ["Code of conduct", "Client wishes", "No rules", "Only profit motive"], "answer": "Code of conduct", "hint": "Ethics.", "explanation": "Brokers must act ethically." },
  { "id": 4003, "question": "Misrepresentation to clients is:", "options": ["Prohibited", "Allowed", "Optional", "Encouraged"], "answer": "Prohibited", "hint": "Fair practice.", "explanation": "Brokers must give correct information." },
  { "id": 4004, "question": "Risk disclosure is:", "options": ["Mandatory", "Optional", "Not required", "Broker choice"], "answer": "Mandatory", "hint": "Investor awareness.", "explanation": "Clients must be informed of risks." },
  { "id": 4005, "question": "Grievance redressal protects:", "options": ["Investors", "Brokers only", "Exchanges only", "Banks only"], "answer": "Investors", "hint": "Complaint handling.", "explanation": "Investors can file complaints." }
]
