[
  {"id":6101,"question":"Forex market primarily deals in:","options":["Shares","Currencies","Bonds","Commodities"],"answer":"Currencies","hint":"Foreign exchange","explanation":"Forex involves trading of different currencies."},
  {"id":6102,"question":"Which authority manages foreign reserves of India?","options":["SEBI","RBI","NITI Aayog","Ministry of Finance"],"answer":"RBI","hint":"Central bank","explanation":"RBI holds and manages foreign reserves."},
  {"id":6103,"question":"Currency quotation in India is generally:","options":["Direct","Indirect","Hybrid","None"],"answer":"Direct","hint":"INR per USD","explanation":"India quotes foreign currency in terms of INR."},
  {"id":6104,"question":"Appreciation of INR means:","options":["INR becomes weaker","INR becomes stronger","No change","Currency banned"],"answer":"INR becomes stronger","hint":"Higher value","explanation":"Appreciation means increase in currency value."},
  {"id":6105,"question":"Which market is decentralized?","options":["Forex","Stock exchange","Bond market","Mutual fund"],"answer":"Forex","hint":"No single exchange","explanation":"Forex trades globally without a central exchange."},
  {"id":6106,"question":"Which is a hard currency?","options":["USD","INR","BDT","NPR"],"answer":"USD","hint":"Global use","explanation":"US Dollar is widely accepted globally."},
  {"id":6107,"question":"Weak rupee helps:","options":["Importers","Exporters","Bankers","SEBI"],"answer":"Exporters","hint":"More earnings","explanation":"Exporters receive more INR when rupee weakens."},
  {"id":6108,"question":"Strong rupee helps:","options":["Exporters","Importers","Traders","SEBI"],"answer":"Importers","hint":"Pay less","explanation":"Importers pay fewer rupees for foreign goods."},
  {"id":6109,"question":"Forex market works:","options":["Only weekdays","Only weekends","24 hours","Only mornings"],"answer":"24 hours","hint":"Global trading","explanation":"Different time zones keep market active."},
  {"id":6110,"question":"Which is NOT a forex participant?","options":["Bank","Corporation","Tourist","Farmer selling crops locally"],"answer":"Farmer selling crops locally","hint":"Domestic trade","explanation":"Local farmers don’t directly trade in forex."},

  {"id":6201,"question":"Forward contracts are mainly used for:","options":["Speculation","Hedging","Bank saving","Insurance"],"answer":"Hedging","hint":"Risk management","explanation":"Forwards reduce currency risk."},
  {"id":6202,"question":"Forwards are traded in:","options":["Stock exchange","OTC market","Commodity exchange","Crypto market"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are negotiated privately."},
  {"id":6203,"question":"Forward contract is settled:","options":["Today","In future","Immediately","After a year"],"answer":"In future","hint":"Pre-agreed date","explanation":"Settlement happens on future date."},
  {"id":6204,"question":"Who mostly uses forward contracts?","options":["Exporters","Students","Doctors","Teachers"],"answer":"Exporters","hint":"Trade protection","explanation":"Exporters hedge currency fluctuations."},
  {"id":6205,"question":"Forward contracts are:","options":["Standardized","Customized","Free","Government issued"],"answer":"Customized","hint":"Flexible terms","explanation":"Terms are decided by both parties."},

  {"id":6301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Indian exchanges","explanation":"All major exchanges trade currency futures."},
  {"id":6302,"question":"Futures are:","options":["Customized","Standardized","Flexible","Free"],"answer":"Standardized","hint":"Exchange rules","explanation":"Contract terms are fixed by exchange."},
  {"id":6303,"question":"Who guarantees futures settlement?","options":["Trader","Clearing house","Bank","RBI"],"answer":"Clearing house","hint":"Risk manager","explanation":"Clearing house reduces default risk."},
  {"id":6304,"question":"Daily profit/loss adjustment is called:","options":["Expiry","Mark-to-market","Delivery","Forward"],"answer":"Mark-to-market","hint":"MTM","explanation":"Daily settlement of gains/losses."},
  {"id":6305,"question":"Margin is paid as:","options":["Fee","Security deposit","Tax","Penalty"],"answer":"Security deposit","hint":"Risk cover","explanation":"Margin protects against losses."},
  {"id":6306,"question":"Lot size is decided by:","options":["Trader","Exchange","RBI","Bank"],"answer":"Exchange","hint":"Fixed quantity","explanation":"Exchange sets contract size."},
  {"id":6307,"question":"If USD/INR rises, exporter:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"More rupees","explanation":"Exporter benefits from higher USD value."},
  {"id":6308,"question":"If USD/INR falls, importer:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"Pays less","explanation":"Importer benefits from lower USD value."},
  {"id":6309,"question":"Most futures expire:","options":["Weekly","Monthly","Yearly","Daily"],"answer":"Monthly","hint":"Last Thursday","explanation":"Common expiry cycle."},
  {"id":6310,"question":"Tick size means:","options":["Lot size","Smallest price movement","Margin","Expiry"],"answer":"Smallest price movement","hint":"Minimum change","explanation":"Minimum allowed price change."},
  {"id":6311,"question":"Long position means:","options":["Buy","Sell","Hold","Save"],"answer":"Buy","hint":"Expect rise","explanation":"Buying a contract."},
  {"id":6312,"question":"Short position means:","options":["Buy","Sell","Deposit","Withdraw"],"answer":"Sell","hint":"Expect fall","explanation":"Selling a contract."},
  {"id":6313,"question":"If price rises, long position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Bought earlier","explanation":"Buyer benefits from price rise."},
  {"id":6314,"question":"If price falls, short position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Sold earlier","explanation":"Seller benefits from price fall."},
  {"id":6315,"question":"Most currency futures are:","options":["Physically settled","Cash settled","Gold settled","Barter"],"answer":"Cash settled","hint":"No delivery","explanation":"Settlement in cash."},
  {"id":6316,"question":"Final settlement price is declared by:","options":["Trader","Exchange","Bank","RBI"],"answer":"Exchange","hint":"Official rate","explanation":"Exchange publishes final price."},
  {"id":6317,"question":"Futures are mainly used for:","options":["Cooking","Hedging","Travel","Shopping"],"answer":"Hedging","hint":"Risk control","explanation":"Used to manage currency risk."},
  {"id":6318,"question":"Most traded pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular pair","explanation":"Most liquid currency pair in India."},
  {"id":6319,"question":"Initial margin is paid:","options":["At start","At expiry","After loss","Never"],"answer":"At start","hint":"Before trading","explanation":"Required before taking position."},
  {"id":6320,"question":"Maintenance margin is:","options":["Higher","Lower","Same","Zero"],"answer":"Lower","hint":"Minimum level","explanation":"Lower than initial margin."},

  {"id":6401,"question":"Option buyer has:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":6402,"question":"Call option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":6403,"question":"Put option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":6404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is option price."},
  {"id":6405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":6406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed price","explanation":"Pre-determined price."},
  {"id":6407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":6408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":6409,"question":"European option can be exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":6410,"question":"American option can be exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible type."},
  {"id":6411,"question":"Call buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Rises","hint":"Right to buy","explanation":"Higher price benefits call buyer."},
  {"id":6412,"question":"Put buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Falls","hint":"Right to sell","explanation":"Lower price benefits put buyer."},
  {"id":6413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer risks only premium."},
  {"id":6414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":6415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":6416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":6417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":6418,"question":"Currency options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Exchange-traded contracts."},
  {"id":6419,"question":"After paying premium, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":6420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
  { "id": 6501, "question": "Main objective of hedging is to:", "options": ["Reduce risk", "Maximize profit", "Avoid tax", "Speculate"], "answer": "Reduce risk", "hint": "Risk management.", "explanation": "Hedging protects against adverse currency movements." },
  { "id": 6502, "question": "If INR weakens, which party benefits?", "options": ["Exporter", "Importer", "Broker", "SEBI"], "answer": "Exporter", "hint": "Receives dollars.", "explanation": "Exporters get more rupees for the same dollars." },
  { "id": 6503, "question": "Importer expecting rupee depreciation should:", "options": ["Buy USD futures", "Sell USD futures", "Buy shares", "Do nothing"], "answer": "Buy USD futures", "hint": "Lock future cost.", "explanation": "Buying futures helps fix dollar rate." },
  { "id": 6504, "question": "Speculators participate mainly to:", "options": ["Earn profit", "Reduce risk", "Avoid trading", "Only hedge"], "answer": "Earn profit", "hint": "Profit motive.", "explanation": "Speculators take risk for potential gains." },
  { "id": 6505, "question": "Arbitrage profit arises due to:", "options": ["Price differences", "High margin", "Fixed return", "No trading"], "answer": "Price differences", "hint": "Market mismatch.", "explanation": "Arbitrageurs exploit price gaps." },
  { "id": 6506, "question": "Which is a direct currency pair?", "options": ["USD/INR", "GBP/USD", "EUR/JPY", "AUD/GBP"], "answer": "USD/INR", "hint": "Involves INR.", "explanation": "Direct pair includes domestic currency." },
  { "id": 6507, "question": "Long hedge means:", "options": ["Buy futures", "Sell futures", "Hold cash", "Cancel trade"], "answer": "Buy futures", "hint": "Lock cost.", "explanation": "Used when prices expected to rise." },
  { "id": 6508, "question": "Short hedge means:", "options": ["Sell futures", "Buy futures", "Hold cash", "Avoid trade"], "answer": "Sell futures", "hint": "Lock revenue.", "explanation": "Used when prices expected to fall." },
  { "id": 6509, "question": "Basis risk exists because:", "options": ["Spot and futures may not move equally", "Only spot moves", "Only futures moves", "No trading"], "answer": "Spot and futures may not move equally", "hint": "Imperfect hedge.", "explanation": "Mismatch creates basis risk." },
  { "id": 6510, "question": "Currency futures are:", "options": ["Standardized contracts", "Custom contracts", "Bank products", "Illegal"], "answer": "Standardized contracts", "hint": "Exchange traded.", "explanation": "Exchanges fix contract terms." },

  { "id": 6601, "question": "ETCD stands for:", "options": ["Exchange Traded Currency Derivatives", "Electronic Currency Trading", "Equity Currency Derivatives", "None"], "answer": "Exchange Traded Currency Derivatives", "hint": "Full form.", "explanation": "Currency derivatives traded on exchanges." },
  { "id": 6602, "question": "Trading in ETCD is:", "options": ["Screen based", "Floor based", "Bank based", "Manual"], "answer": "Screen based", "hint": "Electronic.", "explanation": "Trades executed electronically." },
  { "id": 6603, "question": "Lot size is decided by:", "options": ["Exchange", "Trader", "Broker", "Bank"], "answer": "Exchange", "hint": "Contract terms.", "explanation": "Exchanges fix contract size." },
  { "id": 6604, "question": "Market order gives priority to:", "options": ["Speed", "Price", "Both", "None"], "answer": "Speed", "hint": "Immediate execution.", "explanation": "Executes at best available price." },
  { "id": 6605, "question": "Limit order gives priority to:", "options": ["Price", "Speed", "Broker", "Bank"], "answer": "Price", "hint": "Fixed rate.", "explanation": "Executes only at specified price." },
  { "id": 6606, "question": "IOC stands for:", "options": ["Immediate or Cancel", "Input or Cancel", "Immediate Only", "None"], "answer": "Immediate or Cancel", "hint": "Order type.", "explanation": "Order executes immediately or is cancelled." },
  { "id": 6607, "question": "Open interest increases when:", "options": ["New positions created", "Positions closed", "No trading", "Only settlement"], "answer": "New positions created", "hint": "Fresh contracts.", "explanation": "OI rises with new contracts." },
  { "id": 6608, "question": "Open interest decreases when:", "options": ["Positions squared off", "New trades", "More buying", "More selling"], "answer": "Positions squared off", "hint": "Closing positions.", "explanation": "OI falls when contracts close." },
  { "id": 6609, "question": "Closing price is:", "options": ["Last traded price", "Highest price", "Lowest price", "Average price"], "answer": "Last traded price", "hint": "End of session.", "explanation": "Final price of trading day." },
  { "id": 6610, "question": "Daily price limits are set by:", "options": ["Exchange", "Trader", "Bank", "Broker"], "answer": "Exchange", "hint": "Circuit filter.", "explanation": "Exchanges control extreme movements." },

  { "id": 6701, "question": "Clearing house acts as:", "options": ["Central counterparty", "Trader", "Broker", "Bank"], "answer": "Central counterparty", "hint": "Guarantee.", "explanation": "Stands between buyer and seller." },
  { "id": 6702, "question": "Initial margin is paid by:", "options": ["Both buyer and seller", "Only buyer", "Only seller", "Only broker"], "answer": "Both buyer and seller", "hint": "Risk cover.", "explanation": "Margins collected from both sides." },
  { "id": 6703, "question": "Mark-to-market is done:", "options": ["Daily", "Weekly", "Monthly", "Yearly"], "answer": "Daily", "hint": "Daily adjustment.", "explanation": "Profits/losses settled daily." },
  { "id": 6704, "question": "Variation margin covers:", "options": ["Daily losses", "Initial deposit", "Only profit", "Broker fees"], "answer": "Daily losses", "hint": "MTM adjustment.", "explanation": "Loss traders pay variation margin." },
  { "id": 6705, "question": "Exposure margin depends on:", "options": ["Volatility", "Trader choice", "Fixed rate", "Broker decision"], "answer": "Volatility", "hint": "Risk based.", "explanation": "Higher volatility means higher margin." },
  { "id": 6706, "question": "If margin is not paid, position is:", "options": ["Squared off", "Carried forward", "Ignored", "Transferred"], "answer": "Squared off", "hint": "Default action.", "explanation": "Broker closes position." },
  { "id": 6707, "question": "Final settlement price is based on:", "options": ["RBI reference rate", "Broker rate", "Bank rate", "Trader rate"], "answer": "RBI reference rate", "hint": "Official rate.", "explanation": "RBI rate used for settlement." },
  { "id": 6708, "question": "Settlement type in ETCD is:", "options": ["Cash settlement", "Physical delivery", "Share delivery", "Gold delivery"], "answer": "Cash settlement", "hint": "No actual currency.", "explanation": "Most contracts are cash settled." },
  { "id": 6709, "question": "Default risk is managed by:", "options": ["Clearing corporation", "Trader", "Broker", "Bank"], "answer": "Clearing corporation", "hint": "Risk control.", "explanation": "Clearing house ensures settlement." },
  { "id": 6710, "question": "Margin money is kept with:", "options": ["Clearing corporation", "Broker", "Trader", "Bank"], "answer": "Clearing corporation", "hint": "Safe custody.", "explanation": "Margins are held centrally." },

  { "id": 6801, "question": "Primary regulator of ETCD is:", "options": ["SEBI", "RBI", "IRDA", "PFRDA"], "answer": "SEBI", "hint": "Securities regulator.", "explanation": "SEBI regulates derivatives markets." },
  { "id": 6802, "question": "Currency derivatives fall under:", "options": ["SCRA", "Income Tax Act", "Companies Act", "Banking Act"], "answer": "SCRA", "hint": "Legal framework.", "explanation": "Securities Contracts Act applies." },
  { "id": 6803, "question": "RBI regulates:", "options": ["Forex policy", "Stock trading", "Broker fees", "Tax rules"], "answer": "Forex policy", "hint": "Currency authority.", "explanation": "RBI oversees foreign exchange." },
  { "id": 6804, "question": "Only ______ can execute trades on exchange.", "options": ["Registered brokers", "Anyone", "Only banks", "Only FIIs"], "answer": "Registered brokers", "hint": "Authorized.", "explanation": "Retail trades via brokers." },
  { "id": 6805, "question": "SEBI’s main objective is:", "options": ["Investor protection", "Profit guarantee", "Lower tax", "Bank lending"], "answer": "Investor protection", "hint": "Market safety.", "explanation": "SEBI ensures fair markets." },

  { "id": 6901, "question": "Profit from ETCD is taxed as:", "options": ["Business income", "Salary", "Capital gain", "Dividend"], "answer": "Business income", "hint": "Trading nature.", "explanation": "Derivatives trading treated as business income." },
  { "id": 6902, "question": "MTM loss is:", "options": ["Allowed deduction", "Not allowed", "Capital loss", "Ignored"], "answer": "Allowed deduction", "hint": "Accounting rule.", "explanation": "MTM losses are recognized." },
  { "id": 6903, "question": "Turnover in derivatives is based on:", "options": ["Total contract value", "Only profit", "Only loss", "Only margin"], "answer": "Total contract value", "hint": "Tax basis.", "explanation": "Turnover includes full contract value." },
  { "id": 6904, "question": "Settlement gain is recognized:", "options": ["On settlement date", "Before trade", "Never", "After year end"], "answer": "On settlement date", "hint": "Realization.", "explanation": "Gains booked when settled." },
  { "id": 6905, "question": "ETCD trades must be recorded in:", "options": ["Books of accounts", "Only bank", "Only broker", "Memory"], "answer": "Books of accounts", "hint": "Accounting record.", "explanation": "Proper records mandatory." },

  { "id": 7001, "question": "Investor protection is ensured by:", "options": ["SEBI", "Broker", "Trader", "Bank"], "answer": "SEBI", "hint": "Regulator.", "explanation": "SEBI frames protection measures." },
  { "id": 7002, "question": "Brokers must follow:", "options": ["Code of conduct", "Client wishes", "No rules", "Only profit motive"], "answer": "Code of conduct", "hint": "Ethics.", "explanation": "Brokers must act ethically." },
  { "id": 7003, "question": "Misrepresentation to clients is:", "options": ["Prohibited", "Allowed", "Optional", "Encouraged"], "answer": "Prohibited", "hint": "Fair practice.", "explanation": "Brokers must give correct information." },
