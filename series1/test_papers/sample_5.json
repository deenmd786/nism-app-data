[
  {"id":4101,"question":"Foreign exchange means:","options":["Domestic trade","Exchange of foreign currencies","Stock trading","Gold trading"],"answer":"Exchange of foreign currencies","hint":"Forex","explanation":"Forex refers to buying and selling of foreign currencies."},
  {"id":4102,"question":"Who controls foreign exchange in India?","options":["SEBI","RBI","NSE","IRDA"],"answer":"RBI","hint":"Central Bank","explanation":"RBI regulates foreign exchange in India."},
  {"id":4103,"question":"Which currency is globally accepted?","options":["INR","USD","BDT","NGN"],"answer":"USD","hint":"Reserve currency","explanation":"US Dollar is the most widely used global currency."},
  {"id":4104,"question":"Spot forex settlement is usually:","options":["T+1","T+2","T+5","Immediate"],"answer":"T+2","hint":"Two days","explanation":"Spot transactions generally settle on T+2 basis."},
  {"id":4105,"question":"Exchange rate depends on:","options":["Weather","Demand and supply","SEBI rules","Bank fees"],"answer":"Demand and supply","hint":"Market forces","explanation":"Currency value is driven by demand and supply."},
  {"id":4106,"question":"If INR becomes stronger, it is called:","options":["Depreciation","Appreciation","Inflation","Devaluation"],"answer":"Appreciation","hint":"Higher value","explanation":"Appreciation means increase in currency value."},
  {"id":4107,"question":"Weak INR benefits:","options":["Importers","Exporters","Banks","SEBI"],"answer":"Exporters","hint":"More rupees received","explanation":"Exporters gain when rupee depreciates."},
  {"id":4108,"question":"Forex is mainly used for:","options":["Speculation","International trade","Insurance","Bank deposits"],"answer":"International trade","hint":"Cross-border payments","explanation":"Forex supports global trade and payments."},
  {"id":4109,"question":"Which is NOT a direct forex participant?","options":["Bank","Exporter","Retail shopkeeper","Trader"],"answer":"Retail shopkeeper","hint":"Financial market","explanation":"Retail shopkeepers do not directly trade in forex."},
  {"id":4110,"question":"Forex market operates:","options":["Only day","Only night","24 hours","Only weekdays"],"answer":"24 hours","hint":"Global market","explanation":"Forex runs across different time zones."},

  {"id":4201,"question":"Forward contract is settled:","options":["Today","In future","Never","Weekly"],"answer":"In future","hint":"Advance agreement","explanation":"Forwards are settled on a future date."},
  {"id":4202,"question":"Forwards are traded in:","options":["Exchange","OTC market","Stock market","Commodity market"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are over-the-counter contracts."},
  {"id":4203,"question":"Who mainly uses forwards?","options":["Exporters","Students","Doctors","Engineers"],"answer":"Exporters","hint":"Trade risk","explanation":"Exporters hedge currency risk using forwards."},
  {"id":4204,"question":"Main purpose of derivatives is:","options":["Gambling","Hedging","Saving","Banking"],"answer":"Hedging","hint":"Risk control","explanation":"Derivatives help manage price risk."},
  {"id":4205,"question":"Forwards are usually:","options":["Standardized","Customized","Free","Daily"],"answer":"Customized","hint":"Flexible","explanation":"Terms are negotiated between parties."},

  {"id":4301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Indian exchanges","explanation":"All major exchanges trade currency futures."},
  {"id":4302,"question":"Futures contracts are:","options":["Customized","Standardized","Free","Optional"],"answer":"Standardized","hint":"Exchange rules","explanation":"Contract terms are fixed by exchange."},
  {"id":4303,"question":"Who guarantees settlement in futures?","options":["Trader","Clearing house","Bank","SEBI"],"answer":"Clearing house","hint":"Risk manager","explanation":"Clearing house reduces counterparty risk."},
  {"id":4304,"question":"Daily settlement is called:","options":["Expiry","Mark-to-market","Delivery","Forward"],"answer":"Mark-to-market","hint":"MTM","explanation":"Daily profit/loss adjustment."},
  {"id":4305,"question":"Margin acts as:","options":["Loan","Security deposit","Tax","Interest"],"answer":"Security deposit","hint":"Risk cover","explanation":"Margin protects against default."},
  {"id":4306,"question":"Lot size is decided by:","options":["Trader","Exchange","RBI","Bank"],"answer":"Exchange","hint":"Fixed quantity","explanation":"Exchange defines contract lot size."},
  {"id":4307,"question":"If INR falls, exporter:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"More rupees","explanation":"Weak rupee benefits exporters."},
  {"id":4308,"question":"If INR rises, importer:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"Pays less","explanation":"Strong rupee helps importers."},
  {"id":4309,"question":"Expiry of most contracts is:","options":["Weekly","Monthly","Yearly","Daily"],"answer":"Monthly","hint":"Last Thursday","explanation":"Most currency futures expire monthly."},
  {"id":4310,"question":"Tick size means:","options":["Lot size","Smallest price change","Margin","Expiry"],"answer":"Smallest price change","hint":"Minimum movement","explanation":"Minimum allowed price fluctuation."},
  {"id":4311,"question":"Long position means:","options":["Buy","Sell","Deposit","Withdraw"],"answer":"Buy","hint":"Expect rise","explanation":"Long position is buying."},
  {"id":4312,"question":"Short position means:","options":["Buy","Sell","Hold","Save"],"answer":"Sell","hint":"Expect fall","explanation":"Short position is selling."},
  {"id":4313,"question":"If price rises, long position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Bought earlier","explanation":"Long benefits from price rise."},
  {"id":4314,"question":"If price falls, short position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Sold earlier","explanation":"Short benefits from price fall."},
  {"id":4315,"question":"Futures are mostly:","options":["Physically settled","Cash settled","Gold settled","Barter"],"answer":"Cash settled","hint":"No delivery","explanation":"Most contracts are cash settled."},
  {"id":4316,"question":"Final settlement price is given by:","options":["Trader","Exchange","Bank","RBI"],"answer":"Exchange","hint":"Official rate","explanation":"Exchange declares final price."},
  {"id":4317,"question":"Futures are used for:","options":["Cooking","Hedging","Travel","Shopping"],"answer":"Hedging","hint":"Risk control","explanation":"Used to manage currency risk."},
  {"id":4318,"question":"Most common pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular","explanation":"Widely traded pair in India."},
  {"id":4319,"question":"Initial margin is paid:","options":["At start","At expiry","After loss","Never"],"answer":"At start","hint":"Before trading","explanation":"Paid before entering contract."},
  {"id":4320,"question":"Maintenance margin is:","options":["Higher","Lower","Same","Zero"],"answer":"Lower","hint":"Minimum level","explanation":"Lower than initial margin."},

  {"id":4401,"question":"Option gives buyer a:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":4402,"question":"Call option is right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":4403,"question":"Put option is right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":4404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is price of option."},
  {"id":4405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":4406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed price","explanation":"Predetermined price."},
  {"id":4407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":4408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":4409,"question":"European option is exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":4410,"question":"American option is exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible type."},
  {"id":4411,"question":"Who gains from call when price rises?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to buy","explanation":"Call buyer benefits."},
  {"id":4412,"question":"Who gains from put when price falls?","options":["Buyer","Seller","Bank","Exchange"],"answer":"Buyer","hint":"Right to sell","explanation":"Put buyer benefits."},
  {"id":4413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer loses only premium."},
  {"id":4414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":4415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":4416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":4417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":4418,"question":"Options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Currency options are exchange traded."},
  {"id":4419,"question":"If premium paid, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":4420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
  { "id": 4501, "question": "Currency futures are mainly used for:", "options": ["Hedging", "Dividend", "Bonus issue", "Loan"], "answer": "Hedging", "hint": "Risk cover.", "explanation": "Futures help manage exchange risk." },
  { "id": 4502, "question": "If exporter expects rupee appreciation, he should:", "options": ["Sell USD futures", "Buy USD futures", "Buy shares", "Do nothing"], "answer": "Sell USD futures", "hint": "Lock rate.", "explanation": "Selling futures protects against fall in USD." },
  { "id": 4503, "question": "Speculation involves:", "options": ["Taking risk", "Avoiding risk", "No trading", "Only hedging"], "answer": "Taking risk", "hint": "Profit motive.", "explanation": "Speculators accept risk for gains." },
  { "id": 4504, "question": "Arbitrage is:", "options": ["Risk-free profit", "High risk trade", "Illegal", "Long-term investment"], "answer": "Risk-free profit", "hint": "Price mismatch.", "explanation": "Arbitrage exploits price differences." },
  { "id": 4505, "question": "Hedge ratio depends on:", "options": ["Correlation", "Broker fees", "Tax rate", "Bank rate"], "answer": "Correlation", "hint": "Relationship.", "explanation": "Better correlation improves hedge." },
  { "id": 4506, "question": "Perfect hedge results in:", "options": ["No risk", "High profit", "No trade", "Loss only"], "answer": "No risk", "hint": "Ideal case.", "explanation": "Spot and futures move equally." },
  { "id": 4507, "question": "Basis is:", "options": ["Spot minus futures", "Futures minus spot", "Only spot", "Only futures"], "answer": "Spot minus futures", "hint": "Difference.", "explanation": "Basis = Spot – Futures." },
  { "id": 4508, "question": "If basis narrows, hedge result is:", "options": ["Better", "Worse", "No effect", "Uncertain"], "answer": "Better", "hint": "Convergence.", "explanation": "Narrowing basis improves hedge." },
  { "id": 4509, "question": "Currency futures are traded on:", "options": ["Stock exchange", "Bank counter", "RBI", "Insurance company"], "answer": "Stock exchange", "hint": "ETCD.", "explanation": "They are exchange-traded." },
  { "id": 4510, "question": "Standardization refers to:", "options": ["Fixed contract terms", "Flexible terms", "Bank rules", "Trader rules"], "answer": "Fixed contract terms", "hint": "Exchange feature.", "explanation": "Lot size, expiry, etc., are fixed." },

  { "id": 4601, "question": "Trading in ETCD is:", "options": ["Online", "Physical", "Postal", "Manual only"], "answer": "Online", "hint": "Screen-based.", "explanation": "Trades are executed electronically." },
