  { "id": 4801, "question": "Main regulator of ETCD is:", "options": ["SEBI", "RBI", "IRDA", "PFRDA"], "answer": "SEBI", "hint": "Securities market.", "explanation": "SEBI oversees derivatives." },
  { "id": 4802, "question": "RBI controls:", "options": ["Forex policy", "Broker fees", "Stock prices", "Tax"], "answer": "Forex policy", "hint": "Currency authority.", "explanation": "RBI manages foreign exchange." },
  { "id": 4803, "question": "Currency derivatives come under:", "options": ["SCRA", "Income Tax Act", "Companies Act", "Banking Act"], "answer": "SCRA", "hint": "Law.", "explanation": "Securities Contracts Act applies." },
  { "id": 4804, "question": "Only ______ can place exchange orders.", "options": ["Registered brokers", "Anyone", "Banks only", "RBI"], "answer": "Registered brokers", "hint": "Authorization.", "explanation": "Retail investors trade via brokers." },
  { "id": 4805, "question": "SEBI aims at:", "options": ["Investor protection", "Profit guarantee", "Lower tax", "Bank lending"], "answer": "Investor protection", "hint": "Main objective.", "explanation": "Ensures fair markets." },

  { "id": 4901, "question": "Income from ETCD is treated as:", "options": ["Business income", "Salary", "Dividend", "Gift"], "answer": "Business income", "hint": "Trading nature.", "explanation": "Derivatives are business transactions." },
