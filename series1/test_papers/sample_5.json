  { "id": 4607, "question": "Open interest refers to:", "options": ["Outstanding contracts", "Closed trades", "Only profits", "Only losses"], "answer": "Outstanding contracts", "hint": "Active positions.", "explanation": "Total open positions in market." },
  { "id": 4608, "question": "If new buyer and seller enter, open interest:", "options": ["Increases", "Decreases", "Same", "Zero"], "answer": "Increases", "hint": "New positions.", "explanation": "Fresh contracts add to OI." },
  { "id": 4609, "question": "Daily price band is also called:", "options": ["Circuit filter", "Open price", "Strike price", "Lot size"], "answer": "Circuit filter", "hint": "Limit.", "explanation": "Prevents extreme movement." },
  { "id": 4610, "question": "Trading session ends with:", "options": ["Closing price", "Opening price", "High price", "Low price"], "answer": "Closing price", "hint": "Last traded.", "explanation": "Final price of day." },

  { "id": 4701, "question": "Clearing corporation guarantees:", "options": ["Settlement", "Profit", "Tax", "Broker fee"], "answer": "Settlement", "hint": "CCP role.", "explanation": "It ensures completion of trades." },
  { "id": 4702, "question": "Initial margin is:", "options": ["Security deposit", "Trading profit", "Broker commission", "Tax"], "answer": "Security deposit", "hint": "Risk cover.", "explanation": "Paid at position opening." },
  { "id": 4703, "question": "MTM means:", "options": ["Mark to market", "More to margin", "Market to trade", "None"], "answer": "Mark to market", "hint": "Daily settlement.", "explanation": "Positions valued daily." },
