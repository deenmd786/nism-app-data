  { "id": 9801, "question": "Primary regulator of ETCD is:", "options": ["SEBI", "RBI", "IRDA", "PFRDA"], "answer": "SEBI", "hint": "Market regulator.", "explanation": "SEBI regulates derivatives markets." },
