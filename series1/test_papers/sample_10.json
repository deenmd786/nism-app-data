  {"id":9304,"question":"Daily profit/loss adjustment is called:","options":["Expiry","Mark-to-market","Delivery","Forward"],"answer":"Mark-to-market","hint":"MTM","explanation":"Daily settlement of gains/losses."},
  {"id":9305,"question":"Margin acts as:","options":["Fee","Security deposit","Tax","Penalty"],"answer":"Security deposit","hint":"Risk cover","explanation":"Margin protects against default."},
  {"id":9306,"question":"Lot size is decided by:","options":["Trader","Exchange","RBI","Bank"],"answer":"Exchange","hint":"Fixed quantity","explanation":"Exchange sets contract size."},
