  {"id":9318,"question":"Most traded pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular pair","explanation":"Most liquid currency pair in India."},
  {"id":9319,"question":"Initial margin is paid:","options":["At start","At expiry","After loss","Never"],"answer":"At start","hint":"Before trading","explanation":"Required before taking position."},
  {"id":9320,"question":"Maintenance margin is:","options":["Higher","Lower","Same","Zero"],"answer":"Lower","hint":"Minimum level","explanation":"Lower than initial margin."},

  {"id":9401,"question":"Option buyer has:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":9402,"question":"Call option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":9403,"question":"Put option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":9404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is option price."},
  {"id":9405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":9406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed price","explanation":"Pre-determined price."},
  {"id":9407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":9408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":9409,"question":"European option can be exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":9410,"question":"American option can be exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible type."},
  {"id":9411,"question":"Call buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Rises","hint":"Right to buy","explanation":"Higher price benefits call buyer."},
  {"id":9412,"question":"Put buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Falls","hint":"Right to sell","explanation":"Lower price benefits put buyer."},
  {"id":9413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer risks only premium."},
  {"id":9414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":9415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":9416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":9417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":9418,"question":"Currency options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Exchange-traded contracts."},
  {"id":9419,"question":"After paying premium, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":9420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
