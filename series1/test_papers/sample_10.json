  { "id": 9502, "question": "Exporter gains when:", "options": ["INR depreciates", "INR appreciates", "Interest rates rise", "No change"], "answer": "INR depreciates", "hint": "Receives dollars.", "explanation": "Depreciation gives more rupees per dollar." },
  { "id": 9503, "question": "Importer expecting dollar rise should:", "options": ["Buy USD futures", "Sell USD futures", "Buy shares", "Close account"], "answer": "Buy USD futures", "hint": "Lock future rate.", "explanation": "Buying futures helps fix future cost." },
