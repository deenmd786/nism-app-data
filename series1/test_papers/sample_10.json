  { "id": 9607, "question": "Open interest increases when:", "options": ["New contracts created", "Contracts closed", "No trade", "Only settlement"], "answer": "New contracts created", "hint": "Fresh positions.", "explanation": "OI rises with new positions." },
  { "id": 9608, "question": "Open interest decreases when:", "options": ["Positions squared off", "More buying", "More selling", "New trades"], "answer": "Positions squared off", "hint": "Closing trades.", "explanation": "OI falls when positions close." },
  { "id": 9609, "question": "Closing price refers to:", "options": ["Last traded price", "Highest price", "Lowest price", "Average price"], "answer": "Last traded price", "hint": "End of day.", "explanation": "Final price of trading session." },
  { "id": 9610, "question": "Daily price limits are decided by:", "options": ["Exchange", "Trader", "Broker", "Bank"], "answer": "Exchange", "hint": "Circuit filter.", "explanation": "Exchanges control extreme volatility." },

