[
  {"id":9101,"question":"Foreign Exchange market is mainly for trading:","options":["Shares","Currencies","Bonds","Real estate"],"answer":"Currencies","hint":"Forex","explanation":"Forex market involves exchange of different currencies."},
  {"id":9102,"question":"Which authority regulates foreign exchange in India?","options":["SEBI","RBI","NSE","IRDA"],"answer":"RBI","hint":"Central bank","explanation":"RBI controls and manages foreign exchange in India."},
  {"id":9103,"question":"USD/INR quotation in India is:","options":["Indirect","Direct","Cross","None"],"answer":"Direct","hint":"INR per USD","explanation":"India follows direct quotation method."},
  {"id":9104,"question":"When INR gains value, it is called:","options":["Depreciation","Appreciation","Inflation","Devaluation"],"answer":"Appreciation","hint":"Stronger currency","explanation":"Appreciation means increase in currency value."},
  {"id":9105,"question":"Forex market is:","options":["Centralized","Decentralized","Closed","Local"],"answer":"Decentralized","hint":"Global market","explanation":"Forex operates globally without a central exchange."},
  {"id":9106,"question":"Which is a major reserve currency?","options":["INR","USD","BDT","NPR"],"answer":"USD","hint":"Most accepted","explanation":"US Dollar is the primary global reserve currency."},
  {"id":9107,"question":"Weak rupee benefits:","options":["Importers","Exporters","Bankers","SEBI"],"answer":"Exporters","hint":"More rupees received","explanation":"Exporters gain when INR weakens."},
  {"id":9108,"question":"Strong rupee benefits:","options":["Exporters","Importers","Traders","SEBI"],"answer":"Importers","hint":"Pay less","explanation":"Importers pay fewer rupees when INR strengthens."},
  {"id":9109,"question":"Forex market operates:","options":["Only weekdays","Only weekends","24 hours","Only mornings"],"answer":"24 hours","hint":"Global time zones","explanation":"Forex runs continuously across time zones."},
  {"id":9110,"question":"Which is NOT a direct forex participant?","options":["Bank","MNC","Tourist","Local shopkeeper"],"answer":"Local shopkeeper","hint":"Domestic trade","explanation":"Local shopkeepers do not directly trade in forex."},

  {"id":9201,"question":"Forward contracts are mainly used for:","options":["Speculation","Hedging","Saving","Insurance"],"answer":"Hedging","hint":"Risk control","explanation":"Forwards help manage currency risk."},
  {"id":9202,"question":"Forwards are traded in:","options":["Stock exchange","OTC market","Crypto market","Commodity exchange"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are privately negotiated contracts."},
  {"id":9203,"question":"Forward contract settles:","options":["Today","In future","Immediately","Weekly"],"answer":"In future","hint":"Pre-agreed date","explanation":"Settlement happens on a future date."},
  {"id":9204,"question":"Who mainly uses forward contracts?","options":["Exporters","Students","Doctors","Teachers"],"answer":"Exporters","hint":"Trade protection","explanation":"Exporters hedge currency fluctuations."},
  {"id":9205,"question":"Forwards are:","options":["Standardized","Customized","Free","Government issued"],"answer":"Customized","hint":"Flexible terms","explanation":"Terms are negotiated between parties."},

  {"id":9301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Indian exchanges","explanation":"All major exchanges trade currency futures."},
  {"id":9302,"question":"Futures contracts are:","options":["Customized","Standardized","Flexible","Free"],"answer":"Standardized","hint":"Exchange rules","explanation":"Contract terms are fixed by exchange."},
