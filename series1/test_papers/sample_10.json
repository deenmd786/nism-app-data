  { "id": 9505, "question": "Arbitrage opportunity arises due to:", "options": ["Price differences", "High tax", "Fixed return", "No trading"], "answer": "Price differences", "hint": "Market mismatch.", "explanation": "Arbitrageurs exploit price gaps." },
  { "id": 9506, "question": "USD/INR is a:", "options": ["Direct quote", "Indirect quote", "Cross rate", "Forward rate"], "answer": "Direct quote", "hint": "Includes INR.", "explanation": "Direct quote involves domestic currency." },
  { "id": 9507, "question": "Long hedge means:", "options": ["Buy futures", "Sell futures", "Hold cash", "Avoid trade"], "answer": "Buy futures", "hint": "Lock cost.", "explanation": "Used when prices are expected to rise." },
  { "id": 9508, "question": "Short hedge means:", "options": ["Sell futures", "Buy futures", "Wait", "Cancel trade"], "answer": "Sell futures", "hint": "Lock revenue.", "explanation": "Used when prices are expected to fall." },
  { "id": 9509, "question": "Basis risk occurs because:", "options": ["Spot and futures may not move equally", "Only spot moves", "Only futures move", "No trading"], "answer": "Spot and futures may not move equally", "hint": "Imperfect hedge.", "explanation": "Mismatch creates basis risk." },
  { "id": 9510, "question": "Currency futures are:", "options": ["Standardized contracts", "Custom contracts", "Bank products", "Illegal"], "answer": "Standardized contracts", "hint": "Exchange traded.", "explanation": "Terms are fixed by exchanges." },

  { "id": 9601, "question": "ETCD stands for:", "options": ["Exchange Traded Currency Derivatives", "Electronic Trading Currency", "Equity Trading Derivatives", "None"], "answer": "Exchange Traded Currency Derivatives", "hint": "Full form.", "explanation": "Currency derivatives traded on exchanges." },
  { "id": 9602, "question": "ETCD trading is:", "options": ["Screen based", "Floor based", "Manual", "Bank based"], "answer": "Screen based", "hint": "Electronic.", "explanation": "Trades are executed electronically." },
