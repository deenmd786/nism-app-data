  {"id":8308,"question":"If USD/INR falls, importer:","options":["Gains","Loses","No effect","Depends"],"answer":"Gains","hint":"Pays less","explanation":"Importer benefits from lower USD value."},
  {"id":8309,"question":"Most futures expire:","options":["Weekly","Monthly","Yearly","Daily"],"answer":"Monthly","hint":"Last Thursday","explanation":"Common expiry cycle."},
  {"id":8310,"question":"Tick size means:","options":["Lot size","Smallest price movement","Margin","Expiry"],"answer":"Smallest price movement","hint":"Minimum change","explanation":"Minimum allowed price change."},
  {"id":8311,"question":"Long position means:","options":["Buy","Sell","Hold","Save"],"answer":"Buy","hint":"Expect rise","explanation":"Buying a contract."},
  {"id":8312,"question":"Short position means:","options":["Buy","Sell","Deposit","Withdraw"],"answer":"Sell","hint":"Expect fall","explanation":"Selling a contract."},
  {"id":8313,"question":"If price rises, long position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Bought earlier","explanation":"Buyer benefits from price rise."},
  {"id":8314,"question":"If price falls, short position:","options":["Gains","Loses","No effect","Zero"],"answer":"Gains","hint":"Sold earlier","explanation":"Seller benefits from price fall."},
