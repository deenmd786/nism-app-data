  { "id": 8805, "question": "SEBI’s main goal is:", "options": ["Investor protection", "Profit guarantee", "Lower tax", "Bank lending"], "answer": "Investor protection", "hint": "Fair markets.", "explanation": "SEBI ensures market integrity." },

