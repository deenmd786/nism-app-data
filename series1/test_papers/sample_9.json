  { "id": 8607, "question": "Open interest increases when:", "options": ["New contracts created", "Contracts closed", "No trade", "Only settlement"], "answer": "New contracts created", "hint": "Fresh positions.", "explanation": "OI rises with new positions." },
  { "id": 8608, "question": "Open interest decreases when:", "options": ["Positions squared off", "More buying", "More selling", "New trades"], "answer": "Positions squared off", "hint": "Closing trades.", "explanation": "OI falls when positions close." },
  { "id": 8609, "question": "Closing price refers to:", "options": ["Last traded price", "Highest price", "Lowest price", "Average price"], "answer": "Last traded price", "hint": "End of day.", "explanation": "Final price of trading session." },
  { "id": 8610, "question": "Daily price limits are decided by:", "options": ["Exchange", "Trader", "Broker", "Bank"], "answer": "Exchange", "hint": "Circuit filter.", "explanation": "Exchanges control extreme volatility." },

  { "id": 8701, "question": "Clearing house acts as:", "options": ["Central counterparty", "Trader", "Broker", "Bank"], "answer": "Central counterparty", "hint": "Guarantee.", "explanation": "It stands between buyer and seller." },
  { "id": 8702, "question": "Initial margin is paid by:", "options": ["Both buyer and seller", "Only buyer", "Only seller", "Broker"], "answer": "Both buyer and seller", "hint": "Risk cover.", "explanation": "Margins collected from both sides." },
  { "id": 8703, "question": "Mark-to-market is done:", "options": ["Daily", "Weekly", "Monthly", "Yearly"], "answer": "Daily", "hint": "Daily adjustment.", "explanation": "Profits/losses settled daily." },
