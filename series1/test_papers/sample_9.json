  { "id": 8801, "question": "Primary regulator of ETCD is:", "options": ["SEBI", "RBI", "IRDA", "PFRDA"], "answer": "SEBI", "hint": "Market regulator.", "explanation": "SEBI regulates derivatives markets." },
  { "id": 8802, "question": "Currency derivatives are governed by:", "options": ["SCRA", "Income Tax Act", "Companies Act", "Banking Act"], "answer": "SCRA", "hint": "Legal framework.", "explanation": "Securities Contracts Act applies." },
