  {"id":8318,"question":"Most traded pair in India is:","options":["USD/INR","EUR/GBP","AUD/JPY","CHF/CAD"],"answer":"USD/INR","hint":"Popular pair","explanation":"Most liquid currency pair in India."},
  {"id":8319,"question":"Initial margin is paid:","options":["At start","At expiry","After loss","Never"],"answer":"At start","hint":"Before trading","explanation":"Required before taking position."},
  {"id":8320,"question":"Maintenance margin is:","options":["Higher","Lower","Same","Zero"],"answer":"Lower","hint":"Minimum level","explanation":"Lower than initial margin."},

  {"id":8401,"question":"Option buyer has:","options":["Right","Obligation","Penalty","Loan"],"answer":"Right","hint":"Not compulsory","explanation":"Options give right, not obligation."},
  {"id":8402,"question":"Call option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Buy","hint":"Price rise","explanation":"Call allows buying at strike price."},
  {"id":8403,"question":"Put option gives right to:","options":["Buy","Sell","Borrow","Deposit"],"answer":"Sell","hint":"Price fall","explanation":"Put allows selling at strike price."},
  {"id":8404,"question":"Option buyer pays:","options":["Margin","Premium","Tax","Interest"],"answer":"Premium","hint":"Cost","explanation":"Premium is option price."},
  {"id":8405,"question":"Option seller is called:","options":["Holder","Writer","Trader","Buyer"],"answer":"Writer","hint":"Creates option","explanation":"Seller writes the option."},
  {"id":8406,"question":"Strike price is:","options":["Market price","Fixed price","Future price","Bank rate"],"answer":"Fixed price","hint":"Agreed price","explanation":"Pre-determined price."},
  {"id":8407,"question":"In-the-money means:","options":["Profit","Loss","No value","Zero"],"answer":"Profit","hint":"Favorable","explanation":"Option has intrinsic value."},
  {"id":8408,"question":"Out-of-the-money means:","options":["Profit","Loss","No value","Guaranteed"],"answer":"No value","hint":"Unfavorable","explanation":"No intrinsic value."},
  {"id":8409,"question":"European option can be exercised:","options":["Anytime","Only at expiry","Daily","Weekly"],"answer":"Only at expiry","hint":"Expiry only","explanation":"Exercise only on expiry date."},
  {"id":8410,"question":"American option can be exercised:","options":["Only at expiry","Anytime before expiry","After expiry","Never"],"answer":"Anytime before expiry","hint":"Flexible","explanation":"More flexible type."},
  {"id":8411,"question":"Call buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Rises","hint":"Right to buy","explanation":"Higher price benefits call buyer."},
  {"id":8412,"question":"Put buyer gains when price:","options":["Rises","Falls","Stable","Zero"],"answer":"Falls","hint":"Right to sell","explanation":"Lower price benefits put buyer."},
  {"id":8413,"question":"Maximum loss of option buyer is:","options":["Unlimited","Limited to premium","Zero","Double"],"answer":"Limited to premium","hint":"Fixed loss","explanation":"Buyer risks only premium."},
  {"id":8414,"question":"Maximum profit of option buyer is:","options":["Limited","Unlimited","Zero","Fixed"],"answer":"Unlimited","hint":"No cap","explanation":"Profit can be very high."},
  {"id":8415,"question":"Option premium depends on:","options":["Time","Volatility","Interest rate","All of the above"],"answer":"All of the above","hint":"Pricing factors","explanation":"Many factors affect premium."},
  {"id":8416,"question":"Higher volatility makes premium:","options":["Lower","Higher","Zero","Fixed"],"answer":"Higher","hint":"More risk","explanation":"Risk increases option price."},
  {"id":8417,"question":"Expiry date is:","options":["Start","Last date","Middle","Random"],"answer":"Last date","hint":"End","explanation":"Final date of contract."},
  {"id":8418,"question":"Currency options are traded on:","options":["Exchange","Bank","RBI","Company"],"answer":"Exchange","hint":"Marketplace","explanation":"Exchange-traded contracts."},
  {"id":8419,"question":"After paying premium, buyer is:","options":["Obligated","Not obligated","Forced","Banned"],"answer":"Not obligated","hint":"Right only","explanation":"Buyer is not forced to act."},
  {"id":8420,"question":"Main use of currency options is:","options":["Speculation","Hedging","Gambling","Saving"],"answer":"Hedging","hint":"Risk control","explanation":"Options help manage currency risk."},
  { "id": 8501, "question": "Main objective of hedging in currency derivatives is to:", "options": ["Reduce risk", "Increase leverage", "Avoid tax", "Speculate"], "answer": "Reduce risk", "hint": "Risk management.", "explanation": "Hedging helps protect against adverse currency movements." },
  { "id": 8502, "question": "An exporter benefits when:", "options": ["INR depreciates", "INR appreciates", "Interest rates rise", "No change"], "answer": "INR depreciates", "hint": "Receives dollars.", "explanation": "Depreciation gives more rupees per dollar." },
  { "id": 8503, "question": "Importer expecting dollar rise should:", "options": ["Buy USD futures", "Sell USD futures", "Buy shares", "Close account"], "answer": "Buy USD futures", "hint": "Lock future rate.", "explanation": "Buying futures protects against higher prices." },
  { "id": 8504, "question": "Speculators primarily aim for:", "options": ["Profit", "Hedging", "Regulation", "Tax saving"], "answer": "Profit", "hint": "Risk takers.", "explanation": "Speculators take risk for potential gains." },
  { "id": 8505, "question": "Arbitrage exists due to:", "options": ["Price differences", "High volatility", "Fixed rates", "Government rule"], "answer": "Price differences", "hint": "Market mismatch.", "explanation": "Arbitrageurs exploit price gaps." },
  { "id": 8506, "question": "USD/INR is a:", "options": ["Direct quote", "Indirect quote", "Cross rate", "Forward rate"], "answer": "Direct quote", "hint": "Involves INR.", "explanation": "Direct quote includes domestic currency." },
  { "id": 8507, "question": "Long hedge means:", "options": ["Buying futures", "Selling futures", "Holding cash", "No action"], "answer": "Buying futures", "hint": "Lock cost.", "explanation": "Used when prices are expected to rise." },
  { "id": 8508, "question": "Short hedge means:", "options": ["Selling futures", "Buying futures", "Waiting", "Cancelling"], "answer": "Selling futures", "hint": "Lock revenue.", "explanation": "Used when prices are expected to fall." },
  { "id": 8509, "question": "Basis risk occurs when:", "options": ["Spot and futures don’t move equally", "Only spot moves", "Only futures move", "No trading"], "answer": "Spot and futures don’t move equally", "hint": "Imperfect hedge.", "explanation": "Mismatch creates basis risk." },
  { "id": 8510, "question": "Currency futures are traded on:", "options": ["Exchange", "Bank", "RBI", "Government"], "answer": "Exchange", "hint": "Standardized.", "explanation": "They are exchange-traded contracts." },

  { "id": 8601, "question": "ETCD stands for:", "options": ["Exchange Traded Currency Derivatives", "Electronic Trading Currency", "Equity Trading Derivatives", "None"], "answer": "Exchange Traded Currency Derivatives", "hint": "Full form.", "explanation": "Currency derivatives traded on exchanges." },
  { "id": 8602, "question": "ETCD trading is:", "options": ["Screen based", "Floor based", "Manual", "Bank based"], "answer": "Screen based", "hint": "Electronic.", "explanation": "Trades are executed electronically." },
