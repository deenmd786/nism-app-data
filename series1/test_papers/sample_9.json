[
  {"id":8101,"question":"Foreign Exchange market deals with:","options":["Shares","Currencies","Bonds","Real estate"],"answer":"Currencies","hint":"Forex","explanation":"Forex market involves trading of different currencies."},
  {"id":8102,"question":"Who controls monetary policy in India?","options":["SEBI","RBI","NSE","Finance Ministry"],"answer":"RBI","hint":"Central bank","explanation":"RBI is responsible for monetary policy."},
  {"id":8103,"question":"USD/INR in India is quoted as:","options":["Indirect","Direct","Cross","None"],"answer":"Direct","hint":"INR per USD","explanation":"India follows direct quotation."},
  {"id":8104,"question":"When INR becomes stronger, it is called:","options":["Depreciation","Appreciation","Inflation","Devaluation"],"answer":"Appreciation","hint":"Higher value","explanation":"Appreciation means increase in value."},
  {"id":8105,"question":"Forex market is mainly:","options":["Centralized","Decentralized","Closed","Local"],"answer":"Decentralized","hint":"Global market","explanation":"No single exchange controls forex."},
  {"id":8106,"question":"Which is a global reserve currency?","options":["INR","USD","BDT","NPR"],"answer":"USD","hint":"Most used","explanation":"US Dollar is widely accepted globally."},
  {"id":8107,"question":"Weak INR benefits:","options":["Importers","Exporters","Bankers","SEBI"],"answer":"Exporters","hint":"More rupees","explanation":"Exporters get more INR when rupee weakens."},
  {"id":8108,"question":"Strong INR benefits:","options":["Exporters","Importers","Traders","SEBI"],"answer":"Importers","hint":"Pay less","explanation":"Importers pay fewer rupees."},
  {"id":8109,"question":"Forex market operates:","options":["Only weekdays","Only weekends","24 hours","Only mornings"],"answer":"24 hours","hint":"Global trading","explanation":"Different time zones keep it active."},
  {"id":8110,"question":"Which is NOT a forex participant?","options":["Bank","MNC","Tourist","Local grocery seller"],"answer":"Local grocery seller","hint":"Domestic trade","explanation":"Local sellers do not trade in forex."},

  {"id":8201,"question":"Forward contracts are used for:","options":["Speculation","Hedging","Saving","Insurance"],"answer":"Hedging","hint":"Risk control","explanation":"Forwards help manage currency risk."},
  {"id":8202,"question":"Forwards are traded in:","options":["Stock exchange","OTC market","Crypto market","Commodity exchange"],"answer":"OTC market","hint":"Customized","explanation":"Forwards are privately negotiated."},
  {"id":8203,"question":"Forward contract settles:","options":["Today","In future","Immediately","Weekly"],"answer":"In future","hint":"Pre-agreed date","explanation":"Settlement happens on future date."},
  {"id":8204,"question":"Who mainly uses forwards?","options":["Exporters","Students","Doctors","Teachers"],"answer":"Exporters","hint":"Trade protection","explanation":"Exporters hedge currency risk."},
  {"id":8205,"question":"Forwards are:","options":["Standardized","Customized","Free","Government issued"],"answer":"Customized","hint":"Flexible terms","explanation":"Terms are negotiated."},

  {"id":8301,"question":"Currency futures are traded on:","options":["NSE","BSE","MCX","All of the above"],"answer":"All of the above","hint":"Indian exchanges","explanation":"All major exchanges trade currency futures."},
  {"id":8302,"question":"Futures contracts are:","options":["Customized","Standardized","Flexible","Free"],"answer":"Standardized","hint":"Exchange rules","explanation":"Terms are fixed by exchange."},
