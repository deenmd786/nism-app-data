[
{"id":1,"question":"Which document becomes a legal offer document after pricing?","options":["Final Prospectus","DRHP","RHP","Abridged Prospectus"],"answer":"Final Prospectus","hint":"After price discovery","explanation":"Final prospectus contains the final issue price and is the legal document."},

{"id":2,"question":"Maximum time SEBI can take to give observations on DRHP is:","options":["21 days","7 days","30 days","45 days"],"answer":"21 days","hint":"Cooling-off period","explanation":"SEBI generally completes its review within 21 days."},

{"id":3,"question":"Who publishes the basis of allotment?","options":["Registrar to the Issue","SEBI","Issuer","Banker to Issue"],"answer":"Registrar to the Issue","hint":"Post allotment","explanation":"Registrar publishes the finalized basis of allotment."},

{"id":4,"question":"Fixed price method of IPO is also known as:","options":["Offer for Sale","Book building","Private placement","Rights issue"],"answer":"Offer for Sale","hint":"Non-book built issue","explanation":"In fixed price issues, price is predetermined by issuer."},

{"id":5,"question":"Interest on delayed refund is paid at:","options":["15% per annum","10% per annum","18% per annum","12% per annum"],"answer":"15% per annum","hint":"Penalty rate","explanation":"SEBI mandates 15% p.a. interest for delayed refunds."},

{"id":6,"question":"Cut-off price option allows investor to:","options":["Bid without specifying price","Bid above cap price","Bid below floor price","Bid only at floor price"],"answer":"Bid without specifying price","hint":"Retail facility","explanation":"Retail investors accept final discovered price."},

{"id":7,"question":"ASBA is mandatory for:","options":["All IPO applications","Only retail","Only HNIs","Only QIBs"],"answer":"All IPO applications","hint":"SEBI rule","explanation":"ASBA is now mandatory for all IPO applicants."},

{"id":8,"question":"Stabilization period under Green Shoe is up to:","options":["30 days","15 days","45 days","60 days"],"answer":"30 days","hint":"Post listing","explanation":"Stabilization can be carried out for 30 days after listing."},

{"id":9,"question":"Which is NOT part of client servicing?","options":["IPO pricing","Trade confirmation","Statement of accounts","Complaint redressal"],"answer":"IPO pricing","hint":"Broker role","explanation":"IPO pricing is not a broker’s client servicing function."},

{"id":10,"question":"KYC compliance must be done through:","options":["KRA","Stock exchange","Registrar","Clearing corporation"],"answer":"KRA","hint":"Centralized system","explanation":"KYC is maintained through KYC Registration Agencies."},

{"id":11,"question":"Risk Disclosure Document is given at the time of:","options":["Account opening","IPO allotment","Dividend payment","Trade execution"],"answer":"Account opening","hint":"Onboarding","explanation":"RDD is part of account opening documents."},

{"id":12,"question":"POA is optional for:","options":["Trading","KYC","Demat opening","Bank account"],"answer":"Trading","hint":"Not mandatory","explanation":"POA is optional and not compulsory for trading."},

{"id":13,"question":"Daily margin statement must be sent to client by:","options":["Broker","SEBI","Exchange","Bank"],"answer":"Broker","hint":"Compliance","explanation":"Broker must provide daily margin statement."},

{"id":14,"question":"UCC remains same across:","options":["All brokers in same exchange","All exchanges","All banks","Only one trade"],"answer":"All brokers in same exchange","hint":"Client code","explanation":"UCC is unique per client per exchange."},

{"id":15,"question":"Peak margin is collected to cover:","options":["Maximum intraday exposure","Brokerage","Tax","Dividend"],"answer":"Maximum intraday exposure","hint":"Risk control","explanation":"Peak margin covers highest risk during day."},

{"id":16,"question":"Floating rate bond coupon changes with:","options":["Benchmark rate","Face value","Market price","Maturity"],"answer":"Benchmark rate","hint":"Variable interest","explanation":"Coupon varies with reference rate."},

{"id":17,"question":"Bond convexity measures:","options":["Rate of change of duration","Only price","Only maturity","Only coupon"],"answer":"Rate of change of duration","hint":"Advanced metric","explanation":"Convexity refines interest rate sensitivity."},

{"id":18,"question":"Non-convertible debentures:","options":["Never convert into equity","Fully convert","Partly convert","Convert at maturity"],"answer":"Never convert into equity","hint":"Pure debt","explanation":"NCDs remain debt instruments."},

{"id":19,"question":"Secured debentures are backed by:","options":["Company assets","Bank guarantee","SEBI","Stock exchange"],"answer":"Company assets","hint":"Collateral","explanation":"They have charge on assets."},

{"id":20,"question":"Lowest investment grade rating is:","options":["BBB","BB","AAA","AA"],"answer":"BBB","hint":"Credit rating","explanation":"BBB is the lowest investment grade."},

{"id":21,"question":"Seniority of debt affects:","options":["Repayment priority","Coupon rate","Market price","Tenure"],"answer":"Repayment priority","hint":"Legal claim","explanation":"Senior debt is paid first."},

{"id":22,"question":"Lead manager is also called:","options":["Merchant banker","Registrar","Underwriter","Banker"],"answer":"Merchant banker","hint":"IPO role","explanation":"Merchant banker acts as lead manager."},

{"id":23,"question":"Underwriting commission is paid by:","options":["Issuer","Investor","SEBI","Exchange"],"answer":"Issuer","hint":"Cost of issue","explanation":"Issuer pays commission to underwriter."},

{"id":24,"question":"Registrar coordinates with:","options":["Depositories","RBI","IRDA","Banks only"],"answer":"Depositories","hint":"Demat linkage","explanation":"Registrar works with NSDL/CDSL for allotment."},

{"id":25,"question":"Banker to issue must be:","options":["SCSB","RBI","SEBI","Stock exchange"],"answer":"SCSB","hint":"Self-certified bank","explanation":"Only SCSB banks can act as banker to issue."},

{"id":26,"question":"SEBI can issue:","options":["Regulations","Loans","Insurance","Tax notices"],"answer":"Regulations","hint":"Statutory power","explanation":"SEBI frames and enforces regulations."},

{"id":27,"question":"Merchant banker must conduct:","options":["Due diligence","Trading","Banking","Auditing"],"answer":"Due diligence","hint":"Investor protection","explanation":"They verify issuer disclosures."},

{"id":28,"question":"Which is a method of public offer?","options":["FPO","Private placement","Preferential allotment","Bonus issue"],"answer":"FPO","hint":"Follow-on offer","explanation":"FPO is a public offer by listed company."},

{"id":29,"question":"Price band is disclosed in:","options":["RHP","DRHP","Final prospectus","Abridged prospectus"],"answer":"RHP","hint":"Book building","explanation":"RHP contains floor and cap price."},

{"id":30,"question":"If issue fails, money must be refunded within:","options":["4 working days","7 days","10 days","3 days"],"answer":"4 working days","hint":"SEBI rule","explanation":"Refund must be made within 4 working days."},

{"id":31,"question":"Anchor investors must invest minimum of:","options":["₹10 crore","₹1 crore","₹5 crore","₹25 lakh"],"answer":"₹10 crore","hint":"Institutional rule","explanation":"Minimum anchor bid is ₹10 crore per investor."},

{"id":32,"question":"Price stabilization is carried out by:","options":["Stabilization agent","Issuer","Registrar","Banker"],"answer":"Stabilization agent","hint":"Green shoe","explanation":"Agent manages post-listing price."},

{"id":33,"question":"Primary function of secondary market is:","options":["Liquidity","Capital formation","IPO funding","Loan disbursal"],"answer":"Liquidity","hint":"Trading","explanation":"Investors can exit investments easily."},

{"id":34,"question":"Clearing and settlement is handled by:","options":["Clearing corporation","SEBI","Broker","Bank"],"answer":"Clearing corporation","hint":"Post-trade","explanation":"It manages trade settlement."},

{"id":35,"question":"Depository holds securities in:","options":["Electronic form","Physical form","Bank locker","Paper form"],"answer":"Electronic form","hint":"Demat","explanation":"Depositories maintain dematerialized securities."},

{"id":36,"question":"Margin calls are issued by:","options":["Clearing corporation","RBI","SEBI","Registrar"],"answer":"Clearing corporation","hint":"Risk control","explanation":"It monitors and calls for margins."},

{"id":37,"question":"Mark-to-market profit/loss is settled:","options":["Daily","Weekly","Monthly","At expiry"],"answer":"Daily","hint":"Derivatives","explanation":"MTM is calculated every day."},

{"id":38,"question":"Equity shareholders have:","options":["Residual claim","Fixed claim","Guaranteed return","No rights"],"answer":"Residual claim","hint":"Risk bearer","explanation":"They get what remains after others."},

{"id":39,"question":"Interim dividend is declared by:","options":["Board of Directors","Shareholders","SEBI","RBI"],"answer":"Board of Directors","hint":"Corporate action","explanation":"Board can declare interim dividend."},

{"id":40,"question":"Right issue renunciation means:","options":["Selling rights to others","Forfeiting shares","Buying new shares","Blocking funds"],"answer":"Selling rights to others","hint":"Transferability","explanation":"Shareholders can transfer rights."},

{"id":41,"question":"Options buyer has:","options":["Limited loss","Unlimited loss","No loss","Guaranteed profit"],"answer":"Limited loss","hint":"Risk profile","explanation":"Loss limited to premium paid."},

{"id":42,"question":"Cumulative preference shares:","options":["Accumulate unpaid dividends","Do not get dividends","Convert to equity","Have voting rights"],"answer":"Accumulate unpaid dividends","hint":"Dividend feature","explanation":"Missed dividends accumulate."},

{"id":43,"question":"Warrants can be exercised:","options":["Within specified time","Anytime","Only at maturity","Never"],"answer":"Within specified time","hint":"Convertible","explanation":"Exercise period is defined."},

{"id":44,"question":"Mutual fund units are issued by:","options":["AMC","SEBI","RBI","Stock exchange"],"answer":"AMC","hint":"Fund house","explanation":"Asset Management Company issues units."},

{"id":45,"question":"NAV increases when:","options":["Asset value rises","Units increase","Liabilities rise","Expenses rise"],"answer":"Asset value rises","hint":"Valuation","explanation":"Higher asset value increases NAV."},

{"id":46,"question":"SIP frequency can be:","options":["Monthly or weekly","Only yearly","Only daily","Only quarterly"],"answer":"Monthly or weekly","hint":"Regular investing","explanation":"Common SIP options are monthly/weekly."},

{"id":47,"question":"Preferential allotment pricing is based on:","options":["Average market price","Issuer choice","Bank rate","SEBI discretion"],"answer":"Average market price","hint":"SEBI guideline","explanation":"Pricing follows SEBI formula."},

{"id":48,"question":"Private placement offer letter is called:","options":["PAS-4","RHP","DRHP","Form MGT-7"],"answer":"PAS-4","hint":"Companies Act","explanation":"Private placement is made through PAS-4."
},
  {"id":49,"question":"Which market deals with new securities issuance?","options":["Primary Market","Secondary Market","Money Market","Forex Market"],"answer":"Primary Market","hint":"New issues","explanation":"Primary market is where securities are issued for the first time."},
  {"id":50,"question":"Buying and selling existing securities takes place in:","options":["Primary Market","Secondary Market","Commodity Market","Forex Market"],"answer":"Secondary Market","hint":"Trading market","explanation":"Secondary market facilitates trading of already issued securities."},
  {"id":51,"question":"IPO stands for:","options":["Initial Public Offer","International Public Offer","Investment Public Option","Indian Public Offer"],"answer":"Initial Public Offer","hint":"First issue","explanation":"IPO is the first sale of shares to the public."},
  {"id":52,"question":"FPO stands for:","options":["Further Public Offer","Final Public Offer","First Public Offer","Financial Public Offer"],"answer":"Further Public Offer","hint":"Subsequent issue","explanation":"FPO is an additional issue after IPO."},
  {"id":53,"question":"ASBA is related to:","options":["IPO application","Demat transfer","Share pledge","Dividend payment"],"answer":"IPO application","hint":"Blocked amount","explanation":"ASBA blocks funds in bank during IPO application."},
  {"id":54,"question":"Who approves IPO in India?","options":["RBI","SEBI","MCA","NSE"],"answer":"SEBI","hint":"Issue regulator","explanation":"SEBI reviews and approves IPO documents."},
  {"id":55,"question":"Red Herring Prospectus contains:","options":["Final price","Draft details","Only advertisements","None"],"answer":"Draft details","hint":"Before pricing","explanation":"RHP is issued before final pricing."},
  {"id":56,"question":"Book Building method means:","options":["Fixed price","Price discovery","Auction","Private placement"],"answer":"Price discovery","hint":"Investor bids","explanation":"Investors bid within a price band."},
  {"id":57,"question":"In book building, price range is called:","options":["Floor price","Price band","Market price","Strike price"],"answer":"Price band","hint":"Range","explanation":"Issuer provides a price band for bidding."},
  {"id":58,"question":"Cut-off price means:","options":["Lowest price","Highest price","Final discovered price","No price"],"answer":"Final discovered price","hint":"Retail option","explanation":"Retail investors can apply at cut-off."},
  {"id":59,"question":"Allotment of shares is done by:","options":["SEBI","Registrar","Broker","Bank"],"answer":"Registrar","hint":"R&T Agent","explanation":"Registrar finalizes allotment."},
  {"id":60,"question":"Refund in IPO is processed through:","options":["ASBA","Cheque","Cash","NEFT only"],"answer":"ASBA","hint":"Blocked funds","explanation":"Unallotted amount is released automatically."},
  {"id":61,"question":"Listing of shares means:","options":["Trading allowed","Issue cancelled","Only demat","Only physical"],"answer":"Trading allowed","hint":"Exchange","explanation":"Listed shares can be traded on exchange."},
  {"id":62,"question":"Which is a listing exchange?","options":["NSE","NSDL","RBI","IRDAI"],"answer":"NSE","hint":"Trading platform","explanation":"Companies list on NSE/BSE."},
  {"id":63,"question":"Mutual fund is regulated by:","options":["RBI","SEBI","IRDAI","MCA"],"answer":"SEBI","hint":"Market regulator","explanation":"SEBI regulates mutual funds."},
  {"id":64,"question":"NAV stands for:","options":["Net Asset Value","Net Average Value","Net Approved Value","None"],"answer":"Net Asset Value","hint":"Fund value","explanation":"NAV shows per-unit value of MF."},
  {"id":65,"question":"Who manages mutual fund?","options":["AMC","SEBI","RBI","Bank"],"answer":"AMC","hint":"Asset manager","explanation":"Asset Management Company manages MF."},
  {"id":66,"question":"Open-ended mutual fund allows:","options":["Anytime entry/exit","Fixed maturity","Only trading","No redemption"],"answer":"Anytime entry/exit","hint":"Flexible","explanation":"Investors can buy/sell anytime."},
  {"id":67,"question":"Close-ended fund has:","options":["Fixed maturity","Daily liquidity","No units","Unlimited issue"],"answer":"Fixed maturity","hint":"Tenure","explanation":"Close-ended funds have fixed tenure."},
  {"id":68,"question":"SIP stands for:","options":["Systematic Investment Plan","Special Investment Plan","Simple Investment Policy","None"],"answer":"Systematic Investment Plan","hint":"Regular investing","explanation":"SIP allows periodic investment."},
  {"id":69,"question":"Which is a debt instrument?","options":["Equity","Debenture","Preference share","Bonus share"],"answer":"Debenture","hint":"Loan","explanation":"Debenture represents borrowed capital."},
  {"id":70,"question":"Bond is a:","options":["Equity","Debt","Hybrid","Derivative"],"answer":"Debt","hint":"Fixed income","explanation":"Bond is a fixed-income security."},
  {"id":71,"question":"Government bond is called:","options":["G-Sec","IPO","Mutual fund","Share"],"answer":"G-Sec","hint":"Sovereign","explanation":"G-Sec are issued by government."},
  {"id":72,"question":"Derivative means:","options":["Primary security","Value derived from asset","Physical asset","None"],"answer":"Value derived from asset","hint":"Linked","explanation":"Derivatives derive value from underlying."},
  {"id":73,"question":"Example of derivative:","options":["Share","Bond","Futures","Mutual fund"],"answer":"Futures","hint":"Contract","explanation":"Futures are derivative contracts."},
  {"id":74,"question":"NSE derivative segment is called:","options":["NSE Cash","NSE F&O","BSE Cash","CDSL"],"answer":"NSE F&O","hint":"Futures & Options","explanation":"NSE F&O trades derivatives."},
  {"id":75,"question":"Lot size is decided by:","options":["Broker","Exchange","Investor","Bank"],"answer":"Exchange","hint":"Contract size","explanation":"Exchange sets lot size."},
  {"id":76,"question":"Margin in derivatives is:","options":["Advance payment","Full payment","Optional","Refund only"],"answer":"Advance payment","hint":"Risk cover","explanation":"Margin covers counterparty risk."},
  {"id":77,"question":"Clearing corporation ensures:","options":["Settlement","Trading","IPO","Dividend"],"answer":"Settlement","hint":"Guarantee","explanation":"Clearing corp guarantees settlement."},
  {"id":78,"question":"In India, clearing corp is:","options":["NSCCL","NSDL","RBI","SEBI"],"answer":"NSCCL","hint":"NSE","explanation":"NSCCL clears NSE trades."},
  {"id":79,"question":"Settlement means:","options":["Trade execution","Exchange of funds & securities","Only payment","Only delivery"],"answer":"Exchange of funds & securities","hint":"Final stage","explanation":"Settlement completes trade cycle."},
  {"id":80,"question":"Current settlement cycle for equities:","options":["T+0","T+1","T+2","T+3"],"answer":"T+1","hint":"Latest","explanation":"India follows T+1 settlement."},
  {"id":81,"question":"Who supervises stock exchanges?","options":["SEBI","RBI","MCA","IRDAI"],"answer":"SEBI","hint":"Regulator","explanation":"SEBI oversees exchanges."},
  {"id":82,"question":"Insider trading is:","options":["Legal","Illegal","Optional","Encouraged"],"answer":"Illegal","hint":"PIT","explanation":"Insider trading is prohibited."},
  {"id":83,"question":"Which regulation covers insider trading?","options":["PIT","LODR","ICDR","SCRA"],"answer":"PIT","hint":"Prohibition","explanation":"PIT regulates insider trading."},
  {"id":84,"question":"LODR relates to:","options":["Listing obligations","Depositories","Derivatives","Banking"],"answer":"Listing obligations","hint":"Compliance","explanation":"LODR covers listed companies."},
  {"id":85,"question":"KYC is required for:","options":["Trading","Demat","Bank","All of the above"],"answer":"All of the above","hint":"Compliance","explanation":"KYC is mandatory everywhere."},
  {"id":86,"question":"PAN is mandatory for:","options":["Trading","Banking","Demat","All"],"answer":"All","hint":"Identity","explanation":"PAN is required for all financial transactions."},
  {"id":87,"question":"UPI is mainly used for:","options":["Share trading","Instant payment","Demat transfer","IPO allotment"],"answer":"Instant payment","hint":"Digital","explanation":"UPI enables instant payments."},
  {"id":88,"question":"Which risk is related to interest rate change?","options":["Credit risk","Market risk","Liquidity risk","Operational risk"],"answer":"Market risk","hint":"Price movement","explanation":"Interest rate affects market prices."},
  {"id":89,"question":"Credit risk means:","options":["Price fall","Default by borrower","Delay in trade","System failure"],"answer":"Default by borrower","hint":"Borrower","explanation":"Risk of non-payment."},
  {"id":90,"question":"Operational risk arises from:","options":["Systems failure","Price change","Interest rate","Exchange"],"answer":"Systems failure","hint":"Process","explanation":"Operational issues cause this risk."},
  {"id":91,"question":"Who appoints auditor of company?","options":["SEBI","Shareholders","RBI","Broker"],"answer":"Shareholders","hint":"AGM","explanation":"Auditors are appointed by shareholders."},
  {"id":92,"question":"AGM stands for:","options":["Annual General Meeting","All Government Meeting","Average Growth Meeting","None"],"answer":"Annual General Meeting","hint":"Yearly","explanation":"AGM is held annually."},
  {"id":93,"question":"Proxy allows:","options":["Another person to vote","Direct trading","Loan","Dividend"],"answer":"Another person to vote","hint":"Representation","explanation":"Proxy represents shareholder."},
  {"id":94,"question":"E-voting means:","options":["Online voting","Physical voting","No voting","Postal voting"],"answer":"Online voting","hint":"Digital","explanation":"Shareholders vote electronically."},
  {"id":95,"question":"Who maintains investor complaints?","options":["SEBI","Broker","Bank","Exchange"],"answer":"SEBI","hint":"SCORES","explanation":"SEBI handles complaints via SCORES."},
  {"id":96,"question":"SCORES is a:","options":["Complaint system","Trading platform","Bank app","Exchange"],"answer":"Complaint system","hint":"SEBI","explanation":"SEBI Complaints Redress System."},
  {"id":97,"question":"Which account holds shares?","options":["Savings","Demat","Current","Loan"],"answer":"Demat","hint":"Electronic","explanation":"Demat holds securities."},
  {"id":98,"question":"Which account is used for trading?","options":["Bank","Trading","Demat","Fixed"],"answer":"Trading","hint":"Buy/Sell","explanation":"Trading account executes orders."},
  {"id":99,"question":"Three-in-one account links:","options":["Bank+Demat","Demat+Trading","Bank+Trading+Demat","Only Bank"],"answer":"Bank+Trading+Demat","hint":"Integrated","explanation":"All three linked together."},
  {"id":100,"question":"Who regulates depositories?","options":["SEBI","RBI","MCA","IRDAI"],"answer":"SEBI","hint":"Depositories Act","explanation":"SEBI regulates NSDL/CDSL."}
