{"id":65,"question":"Settlement risk arises when:","options":["Trade fails","Price falls","Broker profits","Market closes"],"answer":"Trade fails","hint":"Default","explanation":"Risk of non-delivery or non-payment."},
{"id":66,"question":"T+1 means:","options":["Trade day + 1 working day","Trade day + 1 month","Same day","One hour later"],"answer":"Trade day + 1 working day","hint":"Cycle","explanation":"Settlement occurs next working day."},
