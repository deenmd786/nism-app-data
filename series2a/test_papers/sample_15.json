{"id":69,"question":"Three-in-one account links:","options":["Bank+Demat+Trading","Bank only","Demat only","Trading only"],"answer":"Bank+Demat+Trading","hint":"Integrated","explanation":"It integrates all three accounts."},
{"id":70,"question":"KYC documents include:","options":["PAN","Aadhaar","Address proof","All of the above"],"answer":"All of the above","hint":"Compliance","explanation":"All are required for KYC."},
