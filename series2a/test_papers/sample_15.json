{"id":61,"question":"Which is a corporate action?","options":["Bonus issue","Trading","Banking","Lending"],"answer":"Bonus issue","hint":"Company event","explanation":"Bonus issue is a corporate action."},
{"id":62,"question":"Stock split changes:","options":["Face value","Market cap","Total shares","Both face value and total shares"],"answer":"Both face value and total shares","hint":"Denomination","explanation":"Split reduces face value and increases shares."},
