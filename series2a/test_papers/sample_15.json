{"id":90,"question":"Proxy voting allows:","options":["Another person to vote","Direct trading","Loan","Dividend"],"answer":"Another person to vote","hint":"Representation","explanation":"Proxy represents shareholder."},
{"id":91,"question":"E-voting means:","options":["Online voting","Postal voting","Physical voting","No voting"],"answer":"Online voting","hint":"Digital","explanation":"Shareholders vote electronically."},
